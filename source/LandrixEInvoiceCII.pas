function TLandrixCIIAmountList.GetItem(Index: TLandrixEInvoiceListIndex): TLandrixCIIAmount;
begin
  if (Index < 0) or (Index >= FCount) then
    raise ELandrixEInvoiceError.Create('TLandrixCIIAmountList index out of range');
  Result := FItems[Index];
end;

procedure TLandrixCIIAmountList.SetItem(Index: TLandrixEInvoiceListIndex; const AValue: TLandrixCIIAmount);
begin
  if (Index < 0) or (Index >= FCount) then
    raise ELandrixEInvoiceError.Create('TLandrixCIIAmountList index out of range');
  FItems[Index] := AValue;
end;

procedure TLandrixCIIAmountList.Add(const AValue: TLandrixCIIAmount);
begin
  if FCount = Length(FItems) then
    SetLength(FItems, FCount * 2 + 4);
  FItems[FCount] := AValue;
  Inc(FCount);
end;

procedure TLandrixCIIAmountList.Delete(Index: TLandrixEInvoiceListIndex);
var
  I: TLandrixEInvoiceListIndex;
begin
  if (Index < 0) or (Index >= FCount) then
    raise ELandrixEInvoiceError.Create('TLandrixCIIAmountList index out of range');
  for I := Index to FCount - 2 do
    FItems[I] := FItems[I + 1];
  Dec(FCount);
  CIIAmountClear(FItems[FCount]);
end;

procedure TLandrixCIIAmountList.Clear;
begin
  FItems := nil;
  FCount := 0;
end;

