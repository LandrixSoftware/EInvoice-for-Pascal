<?xml version="1.0" encoding="UTF-8"?>
<!--
  EInvoice-for-Pascal: validation report, format version 2

  Copyright (C) 2026 Landrix Software GmbH & Co. KG
  SPDX-License-Identifier: GPL-3.0-or-later OR LicenseRef-Landrix-Commercial

  The report of TLandrixEInvoiceValidationReportWriter
  (source/LandrixEInvoiceValidationReport.pas). Version 2 replaces version 1
  (schemas/landrix-einvoice-validation-report-1.xsd, no longer written).

  Versioning: the namespace carries the major version, the attribute
  "version" of the root element the full format version (2.0, 2.1, ...).
  A minor version only adds optional attributes to the elements that have
  attributes (not verdict, location and text, which are plain text), or
  optional elements in another namespace than this one at the end of an
  element with element content; this schema already accepts both (the
  wildcards below). Elements of this namespace cannot be added or
  repeated, so a document has one verdict, a finding one text and so on.

  Two kinds of enumerations:
  - closed, because they carry the meaning of the verdict: verdict, status,
    severity, part (and step, positionIn, source, syntax). A new value or a
    changed meaning is a new major version with a new namespace.
  - open, because they classify: standard, profile, hybridKind,
    configurationChoice, configurationKind. The schema lists the values
    known to this version and accepts any other token; a consumer treats a
    value it does not know as "other". A new value is a minor version.
  Consumers ignore what they do not know.

  Empty values, line and column 0 and false flags are omitted, except
  pdf/@factsChecked, which is always written.

  Changes from version 1: every result is a document element with its
  verdict, parts, PDF facts and findings below it (the writer writes one;
  the schema allows several for a later report on several documents); the
  classifying enumerations are open; a finding has its path in location
  for every part and the business terms of the rule check in @terms (1.0
  had the terms in location); new are @expected, @found and @calculation,
  document/@sha256 and pdf/@invoiceSha256;
  recipient is reserved for recipient profiles (not written yet).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:r="urn:landrix:einvoice:validation-report:2"
    targetNamespace="urn:landrix:einvoice:validation-report:2"
    elementFormDefault="qualified" attributeFormDefault="unqualified">

  <xs:element name="validationReport">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="generator" type="r:Generator"/>
        <xs:element name="document" type="r:Document" maxOccurs="unbounded">
          <!-- every part once: every part is there -->
          <xs:unique name="partName">
            <xs:selector xpath="r:parts/r:part"/>
            <xs:field xpath="@name"/>
          </xs:unique>
          <!-- a recipient once; a finding names a recipient of its document -->
          <xs:key name="recipientName">
            <xs:selector xpath="r:recipient"/>
            <xs:field xpath="@name"/>
          </xs:key>
          <xs:keyref name="findingRecipient" refer="r:recipientName">
            <xs:selector xpath="r:findings/r:finding"/>
            <xs:field xpath="@recipient"/>
          </xs:keyref>
        </xs:element>
        <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="version" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="2\.(0|[1-9][0-9]*)"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:anyAttribute namespace="##any" processContents="lax"/>
    </xs:complexType>
  </xs:element>

  <!-- The library that wrote the report. -->
  <xs:complexType name="Generator">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="version" type="xs:string" use="required"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- One validated document: name as the caller gave it, where the invoice
       came from and what reading found out (root element, syntax, BT-24,
       BT-23); below it the result. specification: only when the library
       knows BT-24. pdf: only for a PDF. -->
  <xs:complexType name="Document">
    <xs:sequence>
      <xs:element name="specification" type="r:Specification" minOccurs="0"/>
      <xs:element name="verdict" type="r:Verdict"/>
      <xs:element name="parts" type="r:Parts"/>
      <xs:element name="pdf" type="r:Pdf" minOccurs="0"/>
      <xs:element name="recipient" type="r:Recipient" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="findings" type="r:Findings"/>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="source" type="r:Source" use="required"/>
    <xs:attribute name="rootName" type="xs:string"/>
    <xs:attribute name="syntax" type="r:Syntax"/>
    <xs:attribute name="customizationId" type="xs:string"/>
    <xs:attribute name="profileId" type="xs:string"/>
    <xs:attribute name="sha256" type="r:Sha256"/>
    <xs:attribute name="sanitized" type="xs:boolean"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- SHA-256 (FIPS 180-4) as 64 lowercase hex digits. document/@sha256: of
       the bytes validated (the whole file, the stream from its position);
       pdf/@invoiceSha256: of the embedded invoice as decoded from the PDF. -->
  <xs:simpleType name="Sha256">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{64}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- The specification the library assigns to BT-24. version is the
       version of the target (e.g. 3.0), libraryRelease the exact release the
       library is built for, not the one of the sender. -->
  <xs:complexType name="Specification">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="standard" type="r:Standard" use="required"/>
    <xs:attribute name="syntax" type="r:Syntax" use="required"/>
    <xs:attribute name="profile" type="r:Profile"/>
    <xs:attribute name="version" type="xs:string"/>
    <xs:attribute name="libraryRelease" type="xs:string"/>
    <xs:attribute name="usesExtension" type="xs:boolean"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- Every part once (the unique constraint on document), written in this
       order: read, kosit, modelCheck, pdfEmbedding, pdfMetadata, pdfA,
       advisory. kosit carries the configuration and the scenario. pdfA and
       advisory never count for the verdict; advisory is never failed. -->
  <xs:complexType name="Parts">
    <xs:sequence>
      <xs:element name="part" type="r:Part" minOccurs="7" maxOccurs="7"/>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <xs:complexType name="Part">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="r:PartName" use="required"/>
    <xs:attribute name="status" type="r:Status" use="required"/>
    <xs:attribute name="configuration" type="xs:string"/>
    <xs:attribute name="scenario" type="xs:string"/>
    <!-- kosit only: how the configuration was chosen (absent without a
         choice); configurationKind for onlyMatch and precedence, candidates
         (registered configurations with exactly one matching scenario) for
         onlyMatch, precedence and noMatch -->
    <xs:attribute name="configurationChoice" type="r:ConfigurationChoice"/>
    <xs:attribute name="configurationKind" type="r:ConfigurationKind"/>
    <xs:attribute name="candidates" type="xs:nonNegativeInteger"/>
    <xs:attribute name="sanitized" type="xs:boolean"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- PDF only: what the PDF checker found, as written in the PDF. profile
       only when factsChecked (derived from the invoice); xmpPdfaPart and
       xmpPdfaConformance are what the XMP claims, not a PDF/A check. -->
  <xs:complexType name="Pdf">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="hybridKind" type="r:HybridKind" use="required"/>
    <xs:attribute name="factsChecked" type="xs:boolean" use="required"/>
    <xs:attribute name="profile" type="r:Profile"/>
    <xs:attribute name="pdfVersion" type="xs:string"/>
    <xs:attribute name="catalogVersion" type="xs:string"/>
    <xs:attribute name="invoiceFileName" type="xs:string"/>
    <xs:attribute name="invoicePath" type="xs:string"/>
    <xs:attribute name="relationship" type="xs:string"/>
    <xs:attribute name="xmpDocumentType" type="xs:string"/>
    <xs:attribute name="xmpDocumentFileName" type="xs:string"/>
    <xs:attribute name="xmpVersion" type="xs:string"/>
    <xs:attribute name="xmpConformanceLevel" type="xs:string"/>
    <xs:attribute name="xmpPdfaPart" type="xs:string"/>
    <xs:attribute name="xmpPdfaConformance" type="xs:string"/>
    <xs:attribute name="invoiceSha256" type="r:Sha256"/>
    <xs:attribute name="sanitized" type="xs:boolean"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- Reserved for recipient profiles (not written yet): the result of the
       rules of one recipient (a public authority, a portal), apart from the
       verdict. name: the profile; its findings carry finding/@recipient
       with the same name. -->
  <xs:complexType name="Recipient">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="name" type="r:OtherToken" use="required"/>
    <xs:attribute name="status" type="r:Status" use="required"/>
    <xs:attribute name="sanitized" type="xs:boolean"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- The findings in the order of the result. errors, warnings, infos count
       the findings that are neither predicted nor advisory; predicted counts
       the predictions of the rule check, advisory the hints of the part
       advisory (infos and warnings). -->
  <xs:complexType name="Findings">
    <xs:sequence>
      <xs:element name="finding" type="r:Finding" minOccurs="0" maxOccurs="unbounded">
        <!-- exactly one of part and recipient -->
        <xs:key name="findingSource">
          <xs:selector xpath="."/>
          <xs:field xpath="@part|@recipient"/>
        </xs:key>
      </xs:element>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="errors" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="warnings" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="infos" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="predicted" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="advisory" type="xs:nonNegativeInteger" use="required"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- part: the part that reported it; a finding of a recipient profile has
       recipient instead (exactly one of the two, the key findingSource). rule: KoSIT code or assert id,
       rule of the own check or the PDF checker, kind of a reading
       diagnostic; absent for a finding of the validation itself. step: KoSIT
       only. positionIn: what line and column count in (the invoice XML, or
       the XMP packet for level 3 findings). predicted: a finding of the own
       rule check. sanitized: a character not allowed in XML was replaced by
       U+FFFD in a value of this finding. location: the XPath (KoSIT), the
       element path (reading, Factur-X code asserts), the model path of the
       rule check (e.g. InvoiceLines[0].LineAmount) or the place in the PDF.
       terms, expected, found, calculation: the business terms and the
       details of the rule check (calculation is text that may change). -->
  <xs:complexType name="Finding">
    <xs:sequence>
      <xs:element name="location" type="xs:string" minOccurs="0"/>
      <xs:element name="text" type="xs:string"/>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="part" type="r:PartName"/>
    <xs:attribute name="recipient" type="r:OtherToken"/>
    <xs:attribute name="rule" type="xs:string"/>
    <xs:attribute name="severity" type="r:Severity" use="required"/>
    <xs:attribute name="step" type="r:Step"/>
    <xs:attribute name="predicted" type="xs:boolean"/>
    <xs:attribute name="line" type="xs:positiveInteger"/>
    <xs:attribute name="column" type="xs:positiveInteger"/>
    <xs:attribute name="positionIn" type="r:PositionIn"/>
    <xs:attribute name="terms" type="xs:string"/>
    <xs:attribute name="expected" type="xs:string"/>
    <xs:attribute name="found" type="xs:string"/>
    <xs:attribute name="calculation" type="xs:string"/>
    <xs:attribute name="sanitized" type="xs:boolean"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:complexType>

  <!-- closed enumerations -->

  <xs:simpleType name="Verdict">
    <xs:restriction base="xs:string">
      <xs:enumeration value="accepted"/>
      <xs:enumeration value="rejected"/>
      <xs:enumeration value="incomplete"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PartName">
    <xs:restriction base="xs:string">
      <xs:enumeration value="read"/>
      <xs:enumeration value="kosit"/>
      <xs:enumeration value="modelCheck"/>
      <xs:enumeration value="pdfEmbedding"/>
      <xs:enumeration value="pdfMetadata"/>
      <xs:enumeration value="pdfA"/>
      <xs:enumeration value="advisory"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Status">
    <xs:restriction base="xs:string">
      <xs:enumeration value="notRun"/>
      <xs:enumeration value="passed"/>
      <xs:enumeration value="failed"/>
      <xs:enumeration value="incomplete"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Severity">
    <xs:restriction base="xs:string">
      <xs:enumeration value="info"/>
      <xs:enumeration value="warning"/>
      <xs:enumeration value="error"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Step">
    <xs:restriction base="xs:string">
      <xs:enumeration value="wellformedness"/>
      <xs:enumeration value="xmlSchema"/>
      <xs:enumeration value="schematron"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PositionIn">
    <xs:restriction base="xs:string">
      <xs:enumeration value="invoice"/>
      <xs:enumeration value="xmp"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Source">
    <xs:restriction base="xs:string">
      <xs:enumeration value="xml"/>
      <xs:enumeration value="pdf"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Syntax">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ubl"/>
      <xs:enumeration value="cii"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- open enumerations: the known values, or any other token -->

  <xs:simpleType name="OtherToken">
    <xs:restriction base="xs:token">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConfigurationChoice">
    <xs:union memberTypes="r:KnownConfigurationChoice r:OtherToken"/>
  </xs:simpleType>

  <xs:simpleType name="KnownConfigurationChoice">
    <xs:restriction base="xs:token">
      <xs:enumeration value="fixed"/>
      <xs:enumeration value="onlyMatch"/>
      <xs:enumeration value="precedence"/>
      <xs:enumeration value="noMatch"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConfigurationKind">
    <xs:union memberTypes="r:KnownConfigurationKind r:OtherToken"/>
  </xs:simpleType>

  <xs:simpleType name="KnownConfigurationKind">
    <xs:restriction base="xs:token">
      <xs:enumeration value="other"/>
      <xs:enumeration value="xrechnung"/>
      <xs:enumeration value="zugferd"/>
      <xs:enumeration value="peppolBIS"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Standard">
    <xs:union memberTypes="r:KnownStandard r:OtherToken"/>
  </xs:simpleType>

  <xs:simpleType name="KnownStandard">
    <xs:restriction base="xs:token">
      <xs:enumeration value="xrechnung"/>
      <xs:enumeration value="facturX"/>
      <xs:enumeration value="peppolBis"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Profile">
    <xs:union memberTypes="r:KnownProfile r:OtherToken"/>
  </xs:simpleType>

  <xs:simpleType name="KnownProfile">
    <xs:restriction base="xs:token">
      <xs:enumeration value="minimum"/>
      <xs:enumeration value="basicWL"/>
      <xs:enumeration value="basic"/>
      <xs:enumeration value="en16931"/>
      <xs:enumeration value="extended"/>
      <xs:enumeration value="xrechnung"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HybridKind">
    <xs:union memberTypes="r:KnownHybridKind r:OtherToken"/>
  </xs:simpleType>

  <xs:simpleType name="KnownHybridKind">
    <xs:restriction base="xs:token">
      <xs:enumeration value="none"/>
      <xs:enumeration value="facturX"/>
      <xs:enumeration value="xrechnung"/>
      <xs:enumeration value="zugferd20"/>
      <xs:enumeration value="zugferd10"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
