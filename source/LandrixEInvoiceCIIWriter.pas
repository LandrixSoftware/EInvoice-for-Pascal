procedure TCIIWriter.WriteAdvancePayment(AObject: TLandrixCIIAdvancePayment; const APath: TLandrixEInvoiceString);
var
  I: TLandrixEInvoiceListIndex;
begin
  if not CIIAmountIsEmpty(AObject.PaidAmount) then
    WriteAmount('ram:PaidAmount', AObject.PaidAmount)
  else
    Missing(APath + '/ram:PaidAmount');
  if not CIIFormattedDateTimeIsEmpty(AObject.FormattedReceivedDateTime) then
    WriteFormattedDateTime('ram:FormattedReceivedDateTime', AObject.FormattedReceivedDateTime, APath + '/ram:FormattedReceivedDateTime');
  for I := 0 to AObject.IncludedTradeTax.Count - 1 do
  begin
    FWriter.StartElement('ram:IncludedTradeTax');
    WriteTradeTax(AObject.IncludedTradeTax[I], APath + '/ram:IncludedTradeTax');
    FWriter.EndElement;
  end;
  if AObject.IncludedTradeTax.Count = 0 then
    Missing(APath + '/ram:IncludedTradeTax');
  if not AObject.InvoiceSpecifiedReferencedDocument.IsEmpty then
  begin
    FWriter.StartElement('ram:InvoiceSpecifiedReferencedDocument');
    WriteReferencedDocument(AObject.InvoiceSpecifiedReferencedDocument, APath + '/ram:InvoiceSpecifiedReferencedDocument');
    FWriter.EndElement;
  end;
end;

procedure TCIIWriter.WriteCreditorFinancialAccount(AObject: TLandrixCIICreditorFinancialAccount);
begin
  if not CIIIDIsEmpty(AObject.IBANID) then
    WriteID('ram:IBANID', AObject.IBANID);
  if AObject.AccountName <> '' then
    FWriter.ElementW('ram:AccountName', AObject.AccountName);
  if not CIIIDIsEmpty(AObject.ProprietaryID) then
    WriteID('ram:ProprietaryID', AObject.ProprietaryID);
end;

