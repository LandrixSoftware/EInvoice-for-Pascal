function TLandrixCIIAdvancePayment.GetIncludedTradeTax: TLandrixCIITradeTaxList;
begin
  if FIncludedTradeTax = nil then
    FIncludedTradeTax := TLandrixCIITradeTaxList.Create;
  Result := FIncludedTradeTax;
end;

function TLandrixCIIAdvancePayment.GetInvoiceSpecifiedReferencedDocument: TLandrixCIIReferencedDocument;
begin
  if FInvoiceSpecifiedReferencedDocument = nil then
    FInvoiceSpecifiedReferencedDocument := TLandrixCIIReferencedDocument.Create;
  Result := FInvoiceSpecifiedReferencedDocument;
end;

destructor TLandrixCIIAdvancePayment.Destroy;
begin
  FIncludedTradeTax.Free;
  FInvoiceSpecifiedReferencedDocument.Free;
  inherited;
end;

procedure TLandrixCIIAdvancePayment.Clear;
begin
  CIIAmountClear(PaidAmount);
  CIIFormattedDateTimeClear(FormattedReceivedDateTime);
  FIncludedTradeTax.Free;
  FIncludedTradeTax := nil;
  FInvoiceSpecifiedReferencedDocument.Free;
  FInvoiceSpecifiedReferencedDocument := nil;
end;

function TLandrixCIIAdvancePayment.IsEmpty: Boolean;
begin
  Result := CIIAmountIsEmpty(PaidAmount) and
    CIIFormattedDateTimeIsEmpty(FormattedReceivedDateTime) and
    ((FIncludedTradeTax = nil) or (FIncludedTradeTax.Count = 0)) and
    ((FInvoiceSpecifiedReferencedDocument = nil) or FInvoiceSpecifiedReferencedDocument.IsEmpty);
end;

