procedure TUBLReader.ReadAddress(AObject: TLandrixUBLAddress; AIsRoot: Boolean);
var
  Seen: array[0..6] of Boolean;
  I: Integer;
begin
  for I := Low(Seen) to High(Seen) do
    Seen[I] := False;
  CheckNoAttributes(AIsRoot);
  if FReader.IsEmptyElement then
  begin
    FReader.Read;
    Exit;
  end;
  while FReader.Read do
    case FReader.TokenType of
      xttEndElement:
        Break;
      xttStartElement:
        if IsElement(NS_CBC, 'StreetName') then
        begin
          if Seen[0] then
            SkipDuplicate
          else
          begin
            Seen[0] := True;
            CheckNoAttributes(False);
            AObject.StreetName := ReadLeaf('string');
          end;
        end
        else if IsElement(NS_CBC, 'AdditionalStreetName') then
        begin
          if Seen[1] then
            SkipDuplicate
          else
          begin
            Seen[1] := True;
            CheckNoAttributes(False);
            AObject.AdditionalStreetName := ReadLeaf('string');
          end;
        end
        else if IsElement(NS_CBC, 'CityName') then
        begin
          if Seen[2] then
            SkipDuplicate
          else
          begin
            Seen[2] := True;
            CheckNoAttributes(False);
            AObject.CityName := ReadLeaf('string');
          end;
        end
        else if IsElement(NS_CBC, 'PostalZone') then
        begin
          if Seen[3] then
            SkipDuplicate
          else
          begin
            Seen[3] := True;
            CheckNoAttributes(False);
            AObject.PostalZone := ReadLeaf('string');
          end;
        end
        else if IsElement(NS_CBC, 'CountrySubentity') then
        begin
          if Seen[4] then
            SkipDuplicate
          else
          begin
            Seen[4] := True;
            CheckNoAttributes(False);
            AObject.CountrySubentity := ReadLeaf('string');
          end;
        end
        else if IsElement(NS_CAC, 'AddressLine') then
        begin
          ReadAddressLine(AObject.AddressLine.Add, False);
        end
        else if IsElement(NS_CAC, 'Country') then
        begin
          if Seen[6] then
