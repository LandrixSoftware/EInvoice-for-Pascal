  end;
  for I := 0 to AObject.AdditionalDocumentReference.Count - 1 do
  begin
    FWriter.StartElement('cac:AdditionalDocumentReference');
    WriteDocumentReference(AObject.AdditionalDocumentReference[I], APath + '/cac:AdditionalDocumentReference');
    FWriter.EndElement;
  end;
  for I := 0 to AObject.OriginatorDocumentReference.Count - 1 do
