  AValue.Value := ReadLeaf('token');
end;

procedure TCIIReader.ReadDate(var AValue: TLandrixCIIDate);
var
  Seen: Boolean;
begin
  CheckNoAttributes(False);
  Seen := False;
  if FReader.IsEmptyElement then
  begin
    FReader.Read;
    Exit;
  end;
  while FReader.Read do
    case FReader.TokenType of
      xttEndElement:
        Break;
      xttStartElement:
        if IsElement(NS_UDT, 'DateString') then
        begin
          if Seen then
            SkipDuplicate
          else
          begin
            Seen := True;
            AValue.Format := AttributeValue('format', ['format']);
            AValue.Value := ReadLeaf('string');
          end;
        end
        else
          SkipUnknown;
      xttText, xttCData:
        if not FReader.IsWhitespace then
          Report(edk_UnexpectedText, 'unexpected text ignored');
    else
      ; { comments and processing instructions are skipped }
    end;
end;

