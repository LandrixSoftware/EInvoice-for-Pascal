function TCIICodeChecker.Holds(AConditions: TCodeConditions; const AValue, AListID: TLandrixEInvoiceString): Boolean;
begin
  Result := False;
  if ((cc_Allowance in AConditions) and (FIndicator <> 'false')) or
     ((cc_Charge in AConditions) and (FIndicator <> 'true')) or
     ((cc_Document130 in AConditions) and (FDocumentType <> '130')) or
     ((cc_Document50 in AConditions) and (FDocumentType <> '50')) or
     ((cc_Document916 in AConditions) and (FDocumentType <> '916')) or
     ((cc_NoListID in AConditions) and (AListID <> '')) or
     ((cc_ListID5153 in AConditions) and (AListID <> '5153')) or
     ((cc_InvoiceCurrency in AConditions) and (LandrixEInvoiceIsBlank(FInvoiceCurrency) or
       (AValue <> FInvoiceCurrency))) or
     ((cc_TaxCurrency in AConditions) and (LandrixEInvoiceIsBlank(FTaxCurrency) or (AValue <> FTaxCurrency))) or
     ((cc_NotInvoiceCurrency in AConditions) and not LandrixEInvoiceIsBlank(FInvoiceCurrency) and
       (AValue = FInvoiceCurrency)) then
    Exit;
  Result := True;
end;

procedure TCIICodeChecker.Value(const AKey, AValue, AListID: TLandrixEInvoiceString);
var
  K, I: Integer;
  Item: TLandrixEInvoiceDiagnostic;
begin
  K := FindKey(AKey);
  if K < 0 then
    Exit;
  for I := Keys[K].First to Keys[K].Last do
  begin
    if (Rules[I].Profile <> FProfile) or ((FRuleID <> '') and (TLandrixEInvoiceString(Rules[I].ID) <> FRuleID)) or
       not Holds(Rules[I].Conditions, AValue, AListID) or Listed(Rules[I].List, AValue) then
      Continue;
    Inc(FCount);
    if FDiagnostics <> nil then
    begin
      Item := FDiagnostics.AddDiagnostic(edk_RuleViolation, AKey, 0, 0, 0, '''' + AValue +
        ''' is not in the code list of Factur-X ' + TLandrixEInvoiceString(ProfileName(FProfile)));
      Item.Severity := eds_Error;
      Item.RuleID := TLandrixEInvoiceString(Rules[I].ID);
    end;
  end;
end;

