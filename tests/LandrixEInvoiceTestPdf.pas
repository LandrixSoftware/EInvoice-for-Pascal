type
  TPdfOffsets = array[0..79] of Integer;

function NoOffsets: TPdfOffsets;
var
  I: Integer;
begin
  for I := Low(Result) to High(Result) do
    Result[I] := 0;
end;

function IntToAnsi(V: Integer): AnsiString;
var
  S: string;
  I: Integer;
begin
  S := IntToStr(V);
  Result := '';
  SetLength(Result, Length(S));
  for I := 1 to Length(S) do
    Result[I] := AnsiChar(Ord(S[I]));
end;

function Pad10(V: Integer): AnsiString;
begin
  Result := IntToAnsi(V);
  while Length(Result) < 10 do
    Result := '0' + Result;
end;

function HexToBytes(const AHex: AnsiString): AnsiString;
var
  I: Integer;

  function Nibble(C: AnsiChar): Integer;
  begin
    case C of
      '0'..'9': Result := Ord(C) - Ord('0');
      'A'..'F': Result := Ord(C) - Ord('A') + 10;
    else
      Result := Ord(C) - Ord('a') + 10;
    end;
  end;

begin
  Result := '';
  SetLength(Result, Length(AHex) div 2);
  for I := 1 to Length(AHex) div 2 do
    Result[I] := AnsiChar(Nibble(AHex[2 * I - 1]) * 16 + Nibble(AHex[2 * I]));
end;

function BytesToHexText(const S: AnsiString): AnsiString;
const
  Digits: AnsiString = '0123456789ABCDEF';
var
  I: Integer;
begin
  Result := '';
  SetLength(Result, 2 * Length(S));
  for I := 1 to Length(S) do
  begin
    Result[2 * I - 1] := Digits[Ord(S[I]) shr 4 + 1];
    Result[2 * I] := Digits[Ord(S[I]) and 15 + 1];
  end;
end;

function Utf8Raw(const S: TLandrixXmlUtf8): AnsiString;
begin
  Result := '';
  SetLength(Result, Length(S));
  if Length(S) > 0 then
    Move(PAnsiChar(S)^, PAnsiChar(Result)^, Length(S));
end;

function StreamText(S: TMemoryStream): AnsiString;
begin
  Result := '';
  SetLength(Result, Integer(S.Size));
  if S.Size > 0 then
    Move(S.Memory^, PAnsiChar(Result)^, Integer(S.Size));
end;

function LoadRaw(const FileName: string): AnsiString;
var
  S: TFileStream;
begin
  Result := '';
  S := TFileStream.Create(FileName, fmOpenRead or fmShareDenyWrite);
  try
    SetLength(Result, Integer(S.Size));
    if S.Size > 0 then
      S.ReadBuffer(PAnsiChar(Result)^, Integer(S.Size));
  finally
    S.Free;
  end;
end;

function ContainsBytes(const AText, ASub: AnsiString): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 1 to Length(AText) - Length(ASub) + 1 do
    if Copy(AText, I, Length(ASub)) = ASub then
    begin
      Result := True;
      Exit;
    end;
end;

{ Position of ASub in AText (1-based), 0 if absent. }
function RawPos(const ASub, AText: AnsiString): Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 1 to Length(AText) - Length(ASub) + 1 do
    if Copy(AText, I, Length(ASub)) = ASub then
    begin
      Result := I;
      Exit;
    end;
end;

{ Bytes as native string for messages, one character per byte. }
function RawText(const S: AnsiString): string;
var
  I: Integer;
begin
  Result := '';
  SetLength(Result, Length(S));
  for I := 1 to Length(S) do
    Result[I] := Char(Ord(S[I]));
end;

function ContainsText(const AText: TLandrixEInvoiceString; const ASub: string): Boolean;
begin
  Result := Pos(ASub, string(AText)) > 0;
end;

{ --- building PDFs ----------------------------------------------------------- }

procedure AddObj(var ABuf: AnsiString; var AOffsets: TPdfOffsets; ANum: Integer; const ABody: AnsiString);
begin
  AOffsets[ANum] := Length(ABuf);
  ABuf := ABuf + IntToAnsi(ANum) + ' 0 obj'#10 + ABody + #10'endobj'#10;
end;

function StreamBody(const ADict, AData: AnsiString): AnsiString;
begin
  Result := '<< ' + ADict + ' /Length ' + IntToAnsi(Length(AData)) + ' >>'#10'stream'#10 + AData + #10'endstream';
end;

{ Appends the xref table of objects 1..ACount-1 and the trailer; returns the
  offset of the table. }
function Finish(var ABuf: AnsiString; const AOffsets: TPdfOffsets; ACount: Integer;
  const ATrailerExtra: AnsiString): Integer;
var
  I: Integer;
begin
  Result := Length(ABuf);
  ABuf := ABuf + 'xref'#10'0 ' + IntToAnsi(ACount) + #10'0000000000 65535 f '#10;
  for I := 1 to ACount - 1 do
    ABuf := ABuf + Pad10(AOffsets[I]) + ' 00000 n '#10;
  ABuf := ABuf + 'trailer'#10'<< /Size ' + IntToAnsi(ACount) + ' /Root 1 0 R' + ATrailerExtra + ' >>'#10 +
    'startxref'#10 + IntToAnsi(Result) + #10'%%EOF'#10;
end;

const
  PdfHeader = '%PDF-1.7'#10;
  CatalogBody = '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles << /Names [(factur-x.xml) 4 0 R] >> >> ' +
    '/AF [4 0 R] >>';
  PagesBody = '<< /Type /Pages /Kids [3 0 R] /Count 1 >>';
  PageBody = '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] >>';

function FilespecBody(const AName: AnsiString): AnsiString;
begin
  Result := '<< /Type /Filespec /F ' + AName + ' /UF ' + AName + ' /EF << /F 5 0 R >> /AFRelationship /Alternative >>';
end;

{ Catalog 1, pages 2, page 3, file specification 4 named AName, embedded
  file 5 with the stream dictionary entries AStreamDict and the data AData. }
function InvoicePdfEx(const AName, AStreamDict, AData: AnsiString; out AXrefOffset: Integer): AnsiString;
var
  O: TPdfOffsets;
begin
  O := NoOffsets;
  Result := PdfHeader;
  AddObj(Result, O, 1, CatalogBody);
  AddObj(Result, O, 2, PagesBody);
  AddObj(Result, O, 3, PageBody);
  AddObj(Result, O, 4, FilespecBody(AName));
  AddObj(Result, O, 5, StreamBody('/Type /EmbeddedFile /Subtype /text#2Fxml ' + AStreamDict, AData));
  AXrefOffset := Finish(Result, O, 6, '');
end;

function InvoicePdf(const AStreamDict, AData: AnsiString): AnsiString;
var
  X: Integer;
begin
  Result := InvoicePdfEx('(factur-x.xml)', AStreamDict, AData, X);
end;

function BuildInvoicePdf(const AXml: AnsiString): AnsiString;
begin
  Result := InvoicePdf('', AXml);
end;

{ --- running the extractor --------------------------------------------------- }

function ExtractInvoice(const APdf: AnsiString; out AXml: AnsiString; out AName: TLandrixEInvoiceString;
  out AInfo: TLandrixEInvoicePdfExtractInfo): Boolean;
var
  Source, Target: TMemoryStream;
begin
  Source := TMemoryStream.Create;
  Target := TMemoryStream.Create;
  try
    if APdf <> '' then
      Source.WriteBuffer(PAnsiChar(APdf)^, Length(APdf));
    Source.Position := 0;
    Result := TLandrixEInvoicePdfExtractor.ExtractInvoiceFromStream(Source, Target, AName, AInfo);
    AXml := StreamText(Target);
  finally
    Target.Free;
    Source.Free;
  end;
end;

function ExtractAll(const APdf: AnsiString; AList: TLandrixEInvoicePdfAttachmentList;
  out AInfo: TLandrixEInvoicePdfExtractInfo): Boolean;
var
  Source: TMemoryStream;
begin
  Source := TMemoryStream.Create;
  try
    if APdf <> '' then
      Source.WriteBuffer(PAnsiChar(APdf)^, Length(APdf));
    Source.Position := 0;
    Result := TLandrixEInvoicePdfExtractor.ExtractAllFromStream(Source, AList, AInfo);
  finally
    Source.Free;
  end;
end;

{ The PDF must give exactly AExpected as invoice. }
procedure CheckInvoice(const APdf, AExpected: AnsiString; const Msg: string);
var
  Xml: AnsiString;
  Name: TLandrixEInvoiceString;
  Info: TLandrixEInvoicePdfExtractInfo;
begin
  Check(ExtractInvoice(APdf, Xml, Name, Info), Msg + ': not extracted: ' + string(Info.Error));
  CheckEqualsBytes(AExpected, Xml, Msg);
  CheckEqualsInvoiceStr('factur-x.xml', Name, Msg + ': name');
  CheckEquals(0, Info.SkippedAttachments, Msg + ': nothing skipped');
end;

{ The only attachment of the PDF must be skipped with a warning containing
  AReason. }
procedure CheckSkipped(const APdf: AnsiString; const AReason, Msg: string);
var
  List: TLandrixEInvoicePdfAttachmentList;
  Info: TLandrixEInvoicePdfExtractInfo;
begin
  List := TLandrixEInvoicePdfAttachmentList.Create;
  try
    Check(ExtractAll(APdf, List, Info), Msg + ': not readable: ' + string(Info.Error));
    Check(List.Count = 0, Msg + ': attachment list must be empty');
    CheckEquals(1, Info.SkippedAttachments, Msg + ': skipped');
    Check(ContainsText(Info.Warning, 'factur-x.xml') and ContainsText(Info.Warning, AReason),
      Msg + ': warning: ' + string(Info.Warning));
  finally
    List.Free;
  end;
end;

{ --- tests ------------------------------------------------------------------ }

{ Only the start counts; the position stays. }
procedure TestDetection;
var
  M: TMemoryStream;
  S: AnsiString;
begin
  M := TMemoryStream.Create;
  try
    S := '<?xml version="1.0"?><Invoice><Note>based on %PDF-1.7</Note></Invoice>';
    M.WriteBuffer(PAnsiChar(S)^, Length(S));
    M.Position := 0;
    Check(not TLandrixEInvoicePdfExtractor.IsPdfStream(M), 'XML with %PDF- in the text');
    CheckEquals(0, Integer(M.Position), 'position kept');
    M.Clear;
    S := BuildInvoicePdf('<x/>');
    M.WriteBuffer(PAnsiChar(S)^, Length(S));
    M.Position := 0;
    Check(TLandrixEInvoicePdfExtractor.IsPdfStream(M), 'PDF detected');
    CheckEquals(0, Integer(M.Position), 'position kept for PDF');
    Check(not TLandrixEInvoicePdfExtractor.IsPdfStream(nil), 'nil stream');
    Check(not TLandrixEInvoicePdfExtractor.IsPdfFile('no-such-file.pdf'), 'missing file');
  finally
    M.Free;
  end;
end;

{ Every filter, own inflate with stored, fixed and dynamic blocks, raw
  deflate, leading white space, predictor and filter chains. }
procedure TestFilters;
var
  Xml, Padded: AnsiString;
  List: TLandrixEInvoicePdfAttachmentList;
  Info: TLandrixEInvoicePdfExtractInfo;
begin
  Xml := VecXml;
  CheckInvoice(InvoicePdf('', Xml), Xml, 'no filter');
  CheckInvoice(InvoicePdf('/Filter /FlateDecode', HexToBytes(VecDynamic)), Xml, 'dynamic Huffman');
  CheckInvoice(InvoicePdf('/Filter /FlateDecode', HexToBytes(VecFixed)), Xml, 'fixed Huffman');
  CheckInvoice(InvoicePdf('/Filter /FlateDecode', HexToBytes(VecStored)), Xml, 'stored');
  CheckInvoice(InvoicePdf('/Filter /Fl', HexToBytes(VecRaw)), Xml, 'raw deflate, short name');
  CheckInvoice(InvoicePdf('/Filter /FlateDecode', #13#10#32 + HexToBytes(VecDynamic)), Xml, 'leading white space');
  CheckInvoice(InvoicePdf('/Filter /LZWDecode', HexToBytes(VecLzw)), Xml + Xml + Xml, 'LZW, 9 to 11 bits');
  CheckInvoice(InvoicePdf('/Filter /ASCII85Decode', HexToBytes(VecA85)), Xml, 'ASCII85');
  CheckInvoice(InvoicePdf('/Filter /AHx', BytesToHexText(Xml) + '>'), Xml, 'ASCIIHex');
  CheckInvoice(InvoicePdf('/Filter /RunLengthDecode', HexToBytes(VecRunLength)), Xml, 'RunLength');
  CheckInvoice(InvoicePdf('/Filter [/ASCII85Decode /FlateDecode]', HexToBytes(VecA85Flate)), Xml, 'filter chain');
  Padded := Xml;
  while Length(Padded) mod 61 <> 0 do
    Padded := Padded + ' ';
  CheckInvoice(InvoicePdf('/Filter /FlateDecode /DecodeParms << /Predictor 12 /Columns 61 >>', HexToBytes(VecPngUp)),
    Padded, 'PNG predictor');

  List := TLandrixEInvoicePdfAttachmentList.Create;
  try
    Check(ExtractAll(InvoicePdf('/Filter /FlateDecode', HexToBytes(VecDynamic)), List, Info), 'all');
    Check(List.Count = 1, 'one attachment');
    Check(List[0].Kind = epa_Invoice, 'kind');
    CheckEqualsInvoiceStr('CrossIndustryInvoice', List[0].RootElement, 'root element');
    CheckEqualsInvoiceStr('text/xml', List[0].MimeType, 'MIME type');
    CheckEqualsInvoiceStr('Alternative', List[0].Relationship, 'relationship');
    CheckEquals(Length(Xml), List[0].Size, 'size');
    CheckEquals(0, Integer(List[0].Data.Position), 'data at position 0');
    CheckEquals(1, Info.XrefSections, 'one xref section');
    Check(not Info.UsedReconstruction and not Info.Encrypted, 'plain file');
    CheckEqualsInvoiceStr('1.7', Info.PdfVersion, 'version');
    Check(List[1] = nil, 'nil outside the list');
  finally
    List.Free;
  end;
end;

{ Truncated data is kept as far as it was decoded; failing filters and
  limits skip the attachment with a warning. }
procedure TestDamagedStreams;
var
  Full, Cut, Xml: AnsiString;
  Name: TLandrixEInvoiceString;
  Info: TLandrixEInvoicePdfExtractInfo;
begin
  Full := HexToBytes(VecDynamic);
  Cut := Copy(Full, 1, Length(Full) div 2);
  Check(ExtractInvoice(InvoicePdf('/Filter /FlateDecode', Cut), Xml, Name, Info), 'truncated: ' + string(Info.Error));
  Check((Xml <> '') and (Length(Xml) < Length(VecXml)), 'truncated: partial output');
  CheckEqualsBytes(Copy(VecXml, 1, Length(Xml)), Xml, 'truncated: a prefix of the invoice');

  CheckSkipped(InvoicePdf('/Filter /FlateDecode', 'XXXXXXXXXXXXXXXX'), 'FlateDecode', 'corrupt Flate');
  CheckSkipped(InvoicePdf('/Filter [/FlateDecode /FlateDecode]', HexToBytes(VecBomb)), 'exceeds', 'decompression bomb');
  CheckSkipped(InvoicePdf('/Filter /ASCII85Decode', 'uuuuu~>'), 'ASCII85Decode', 'ASCII85 group above 2^32');
  CheckSkipped(InvoicePdf('/Filter /DCTDecode', 'abc'), 'DCTDecode', 'unsupported filter');

  Check(not ExtractInvoice(InvoicePdf('/Filter /FlateDecode', 'XXXXXXXXXXXXXXXX'), Xml, Name, Info),
    'no invoice after skip');
  Check(ContainsText(Info.Error, 'no embedded files'), 'message: ' + string(Info.Error));
end;

{ Files that are not PDFs, PDFs without attachments or invoice, name trees
  with kids, file name encodings, the choice of the invoice. }
procedure TestStructure;
var
  Pdf, Xml: AnsiString;
  O: TPdfOffsets;
  Name: TLandrixEInvoiceString;
  Expected: TLandrixEInvoiceString;
  Info: TLandrixEInvoicePdfExtractInfo;
  List: TLandrixEInvoicePdfAttachmentList;
  M: TMemoryStream;
begin
  O := NoOffsets;
  Check(not ExtractInvoice('hello', Xml, Name, Info), 'not a PDF');
  Check(ContainsText(Info.Error, 'Not a PDF'), 'message: ' + string(Info.Error));
  Check(not ExtractInvoice('', Xml, Name, Info), 'empty');
  Check(ContainsText(Info.Error, 'Empty'), 'message: ' + string(Info.Error));

  M := TMemoryStream.Create;
  try
    Check(not TLandrixEInvoicePdfExtractor.ExtractInvoiceFromStream(M, nil, Name, Info), 'no target');
    Check(not TLandrixEInvoicePdfExtractor.ExtractAllFromStream(M, nil, Info), 'no list');
  finally
    M.Free;
  end;
  Check(not TLandrixEInvoicePdfExtractor.ExtractInvoiceFromFile('no-such-file.pdf', nil, Name, Info),
    'missing file');

  { catalog without attachments }
  Pdf := PdfHeader;
  AddObj(Pdf, O, 1, '<< /Type /Catalog /Pages 2 0 R >>');
  AddObj(Pdf, O, 2, PagesBody);
  Finish(Pdf, O, 3, '');
  List := TLandrixEInvoicePdfAttachmentList.Create;
  try
    Check(ExtractAll(Pdf, List, Info), 'readable without attachments');
    Check(List.Count = 0, 'no attachments');
    Check(not ExtractInvoice(Pdf, Xml, Name, Info), 'no invoice');
    Check(ContainsText(Info.Error, 'no embedded files'), 'message: ' + string(Info.Error));

    { only a text attachment }
    List.Clear;
    Pdf := InvoicePdf('', 'hello');
    Check(ExtractAll(Pdf, List, Info), 'text attachment');
    Check((List.Count = 1) and (List[0].Kind = epa_Other) and (List[0].RootElement = ''), 'kind other');
    Check(not ExtractInvoice(Pdf, Xml, Name, Info), 'no invoice in text');
    Check(ContainsText(Info.Error, '1 embedded file'), 'message: ' + string(Info.Error));

    { other XML }
    List.Clear;
    Check(ExtractAll(InvoicePdf('', '<?xml version="1.0"?><!-- c --><o:Order xmlns:o="urn:o"/>'), List, Info),
      'other XML');
    Check((List.Count = 1) and (List[0].Kind = epa_OtherXml), 'kind other XML');
    CheckEqualsInvoiceStr('Order', List[0].RootElement, 'root without prefix');

    { name tree with kids; /UF in UTF-16BE, /F in PDFDocEncoding }
    List.Clear;
    Pdf := PdfHeader;
    AddObj(Pdf, O, 1, '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles << /Kids [6 0 R] >> >> >>');
    AddObj(Pdf, O, 2, PagesBody);
    AddObj(Pdf, O, 3, PageBody);
    AddObj(Pdf, O, 4, '<< /Type /Filespec /F (a\200b.xml) /UF <FEFF0066006100E400DF0020007820AC002E0078006D006C> ' +
      '/EF << /F 5 0 R >> >>');
    AddObj(Pdf, O, 5, StreamBody('/Type /EmbeddedFile', '<Invoice/>'));
    AddObj(Pdf, O, 6, '<< /Names [(first) 4 0 R (second) 7 0 R] >>');
    AddObj(Pdf, O, 7, '<< /Type /Filespec /F (a\200b.xml) /EF << /F 8 0 R >> >>');
    AddObj(Pdf, O, 8, StreamBody('/Type /EmbeddedFile', '<CreditNote/>'));
    Finish(Pdf, O, 9, '');
    Check(ExtractAll(Pdf, List, Info), 'name tree with kids: ' + string(Info.Error));
    Check(List.Count = 2, 'two attachments from the kids');
    Expected := 'fa';
    Expected := Expected + WideChar($E4) + WideChar($DF) + ' x' + WideChar($20AC) + '.xml';
    CheckEqualsInvoiceStr(Expected, List[0].FileName, 'UTF-16BE name');
    Expected := 'a';
    Expected := Expected + WideChar($2022) + 'b.xml';
    CheckEqualsInvoiceStr(Expected, List[1].FileName, 'PDFDocEncoding name');
    Check(List[1].Kind = epa_Invoice, 'CreditNote is an invoice');
    CheckEquals(0, Integer(TLandrixEInvoicePdfExtractor.FindInvoiceIndex(List)), 'first invoice without specified name');
    List[1].FileName := 'ZUGFeRD-invoice.xml ';
    CheckEquals(1, Integer(TLandrixEInvoicePdfExtractor.FindInvoiceIndex(List)), 'specified name wins');
    List[1].Kind := epa_OtherXml;
    CheckEquals(0, Integer(TLandrixEInvoicePdfExtractor.FindInvoiceIndex(List)), 'name alone is not enough');
    CheckEquals(-1, Integer(TLandrixEInvoicePdfExtractor.FindInvoiceIndex(nil)), 'nil list');
  finally
    List.Free;
  end;
end;

{ An incremental update replaces the embedded file; only the new version
  counts, also though the old one stays in the file. }
procedure TestIncrementalUpdate;
const
  OldXml = '<rsm:CrossIndustryInvoice xmlns:rsm="urn:x"><V>FIRST-REPLACED</V></rsm:CrossIndustryInvoice>';
  NewXml = '<rsm:CrossIndustryInvoice xmlns:rsm="urn:x"><V>SECOND-VALID</V></rsm:CrossIndustryInvoice>';
var
  Pdf, Xml: AnsiString;
  X1, X2, Ofs: Integer;
  Name: TLandrixEInvoiceString;
  Info: TLandrixEInvoicePdfExtractInfo;
begin
  Pdf := InvoicePdfEx('(factur-x.xml)', '', OldXml, X1);
  Ofs := Length(Pdf);
  Pdf := Pdf + '5 0 obj'#10 + StreamBody('/Type /EmbeddedFile /Subtype /text#2Fxml', NewXml) + #10'endobj'#10;
  X2 := Length(Pdf);
  Pdf := Pdf + 'xref'#10'5 1'#10 + Pad10(Ofs) + ' 00000 n '#10 + 'trailer'#10'<< /Size 6 /Root 1 0 R /Prev ' +
    IntToAnsi(X1) + ' >>'#10'startxref'#10 + IntToAnsi(X2) + #10'%%EOF'#10;
  Check(ExtractInvoice(Pdf, Xml, Name, Info), 'extracted: ' + string(Info.Error));
  CheckEqualsBytes(NewXml, Xml, 'the current version');
  CheckEquals(2, Info.XrefSections, 'two xref sections');
  Check(not Info.UsedReconstruction, 'xref chain used, not a scan');

  { /Prev pointing to itself: no endless loop }
  Pdf := Copy(Pdf, 1, X2) + 'xref'#10'5 1'#10 + Pad10(Ofs) + ' 00000 n '#10 + 'trailer'#10'<< /Size 6 /Root 1 0 R /Prev ' +
    IntToAnsi(X2) + ' >>'#10'startxref'#10 + IntToAnsi(X2) + #10'%%EOF'#10;
  Check(ExtractInvoice(Pdf, Xml, Name, Info), 'cyclic /Prev: ' + string(Info.Error));
  CheckEqualsBytes(NewXml, Xml, 'cyclic /Prev: current version');

  { a broken startxref forces the reconstruction; the last definition wins }
  Pdf := Copy(Pdf, 1, X2) + 'startxref'#10'999999'#10'%%EOF'#10;
  Check(ExtractInvoice(Pdf, Xml, Name, Info), 'reconstructed: ' + string(Info.Error));
  Check(Info.UsedReconstruction, 'reconstruction reported');
  CheckEqualsBytes(NewXml, Xml, 'reconstruction: last definition');
end;

{ Hybrid file (ISO 32000-1, 7.5.8.4): the classic table lists the file
  specification in an object stream as free, the /XRefStm stream has the
  real entry. Conversely an older table must not revive an object a newer
  update freed. }
procedure TestHybridXref;
const
  Xml = '<rsm:CrossIndustryInvoice xmlns:rsm="urn:x"><V>HYBRID</V></rsm:CrossIndustryInvoice>';
  ObjStmHead = '4 0 ';
var
  Pdf, Body, Got: AnsiString;
  O: TPdfOffsets;
  Classic, X1, X2, I: Integer;
  Name: TLandrixEInvoiceString;
  Info: TLandrixEInvoicePdfExtractInfo;

  function Row(AType, AField2, AField3: Integer): AnsiString;
  begin
    Result := AnsiChar(AType) + AnsiChar((AField2 shr 24) and $FF) + AnsiChar((AField2 shr 16) and $FF) +
      AnsiChar((AField2 shr 8) and $FF) + AnsiChar(AField2 and $FF) + AnsiChar((AField3 shr 8) and $FF) +
      AnsiChar(AField3 and $FF);
  end;

begin
  O := NoOffsets;
  Body := ObjStmHead + FilespecBody('(factur-x.xml)');
  Pdf := PdfHeader;
  AddObj(Pdf, O, 1, CatalogBody);
  AddObj(Pdf, O, 2, PagesBody);
  AddObj(Pdf, O, 3, PageBody);
  AddObj(Pdf, O, 5, StreamBody('/Type /EmbeddedFile /Subtype /text#2Fxml', Xml));
  AddObj(Pdf, O, 6, StreamBody('/Type /ObjStm /N 1 /First ' + IntToAnsi(Length(ObjStmHead)), Body));
  O[7] := Length(Pdf);
  Pdf := Pdf + '7 0 obj'#10 + StreamBody('/Type /XRef /Size 8 /W [1 4 2] /Root 1 0 R',
    Row(0, 0, 65535) + Row(1, O[1], 0) + Row(1, O[2], 0) + Row(1, O[3], 0) + Row(2, 6, 0) + Row(1, O[5], 0) +
    Row(1, O[6], 0) + Row(1, O[7], 0)) + #10'endobj'#10;
  Classic := Length(Pdf);
  Pdf := Pdf + 'xref'#10'0 8'#10'0000000004 65535 f '#10;
  for I := 1 to 3 do
    Pdf := Pdf + Pad10(O[I]) + ' 00000 n '#10;
  Pdf := Pdf + '0000000000 00000 f '#10;
  for I := 5 to 7 do
    Pdf := Pdf + Pad10(O[I]) + ' 00000 n '#10;
  Pdf := Pdf + 'trailer'#10'<< /Size 8 /Root 1 0 R /XRefStm ' + IntToAnsi(O[7]) + ' >>'#10'startxref'#10 +
    IntToAnsi(Classic) + #10'%%EOF'#10;
  Check(ExtractInvoice(Pdf, Got, Name, Info), 'hybrid: ' + string(Info.Error));
  CheckEqualsBytes(Xml, Got, 'hybrid: /XRefStm replaces the free placeholder');

  { update freeing object 4 }
  Pdf := InvoicePdfEx('(factur-x.xml)', '', Xml, X1);
  X2 := Length(Pdf);
  Pdf := Pdf + 'xref'#10'4 1'#10'0000000000 00001 f '#10'trailer'#10'<< /Size 6 /Root 1 0 R /Prev ' + IntToAnsi(X1) +
    ' >>'#10'startxref'#10 + IntToAnsi(X2) + #10'%%EOF'#10;
  Check(not ExtractInvoice(Pdf, Got, Name, Info), 'freed object stays freed');
end;

{ PDF with the RC4 test vectors around objects 1 (name tree), 4 (file
  specification), 5 (stream) and 6 (/Encrypt); /ID[0] is 00 01 .. 0F. }
function EncryptedPdf(const AEncDict, ANameHex1, ANameHex4, ADataHex: AnsiString; AFlate: Boolean): AnsiString;
var
  O: TPdfOffsets;
  Filter: AnsiString;
begin
  O := NoOffsets;
  if AFlate then
    Filter := ' /Filter /FlateDecode'
  else
    Filter := '';
  Result := '%PDF-1.6'#10;
  AddObj(Result, O, 1, '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles << /Names [ <' + ANameHex1 +
    '> 4 0 R ] >> >> /AF [ 4 0 R ] >>');
  AddObj(Result, O, 2, PagesBody);
  AddObj(Result, O, 3, PageBody);
  AddObj(Result, O, 4, '<< /Type /Filespec /F <' + ANameHex4 + '> /UF <' + ANameHex4 +
    '> /EF << /F 5 0 R >> /AFRelationship /Alternative >>');
  AddObj(Result, O, 5, StreamBody('/Type /EmbeddedFile /Subtype /text#2Fxml' + Filter, HexToBytes(ADataHex)));
  AddObj(Result, O, 6, AEncDict);
  Finish(Result, O, 7, ' /Encrypt 6 0 R /ID [ <000102030405060708090A0B0C0D0E0F> <000102030405060708090A0B0C0D0E0F> ]');
end;

