    epr_Basic: Result := 'BASIC';
    epr_EN16931: Result := 'EN16931';
  else
    Result := 'EXTENDED';
  end;
end;

{ ordinal comparison; the tables are sorted by code point }
function CompareCode(const A: TLandrixEInvoiceString; const B: string): Integer;
var
  I, N: Integer;
begin
  N := Length(A);
  if Length(B) < N then
    N := Length(B);
  for I := 1 to N do
    if Ord(A[I]) <> Ord(B[I]) then
    begin
      Result := Ord(A[I]) - Ord(B[I]);
      Exit;
    end;
  Result := Length(A) - Length(B);
end;

function FindKey(const AKey: TLandrixEInvoiceString): Integer;
var
  Lo, Hi, Mid, C: Integer;
begin
  Lo := Low(Keys);
  Hi := High(Keys);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    C := CompareCode(AKey, Keys[Mid].Key);
    if C = 0 then
    begin
      Result := Mid;
      Exit;
    end;
    if C < 0 then
      Hi := Mid - 1
    else
      Lo := Mid + 1;
  end;
  Result := -1;
end;

function Listed(AList: Integer; const AValue: TLandrixEInvoiceString): Boolean;
var
  Lo, Hi, Mid, C: Integer;
begin
  Lo := Lists[AList].First;
  Hi := Lo + Lists[AList].Count - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    C := CompareCode(AValue, Codes[Mid]);
    if C = 0 then
    begin
      Result := True;
      Exit;
    end;
    if C < 0 then
      Hi := Mid - 1
    else
      Lo := Mid + 1;
  end;
  Result := False;
end;

