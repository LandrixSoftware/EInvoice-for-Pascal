procedure TCIIReader.ReadAdvancePayment(AObject: TLandrixCIIAdvancePayment; AIsRoot: Boolean);
var
  Seen: array[0..3] of Boolean;
  I: Integer;
begin
  for I := Low(Seen) to High(Seen) do
    Seen[I] := False;
  CheckNoAttributes(AIsRoot);
  if FReader.IsEmptyElement then
  begin
    FReader.Read;
    Exit;
  end;
  while FReader.Read do
    case FReader.TokenType of
      xttEndElement:
        Break;
      xttStartElement:
        if IsElement(NS_RAM, 'PaidAmount') then
        begin
          if Seen[0] then
            SkipDuplicate
          else
          begin
            Seen[0] := True;
            ReadAmount(AObject.PaidAmount);
          end;
        end
        else if IsElement(NS_RAM, 'FormattedReceivedDateTime') then
        begin
          if Seen[1] then
            SkipDuplicate
          else
          begin
            Seen[1] := True;
            ReadFormattedDateTime(AObject.FormattedReceivedDateTime);
          end;
        end
        else if IsElement(NS_RAM, 'IncludedTradeTax') then
        begin
          ReadTradeTax(AObject.IncludedTradeTax.Add, False);
        end
        else if IsElement(NS_RAM, 'InvoiceSpecifiedReferencedDocument') then
        begin
          if Seen[3] then
            SkipDuplicate
          else
          begin
            Seen[3] := True;
            ReadReferencedDocument(AObject.InvoiceSpecifiedReferencedDocument, False);
          end;
        end
        else
          SkipUnknown;
      xttText, xttCData:
        if not FReader.IsWhitespace then
          Report(edk_UnexpectedText, 'unexpected text ignored');
    else
      ; { comments and processing instructions are skipped }
    end;
end;

