{ S with every '\' plus four hex digits replaced by that character }
function Decoded(const S: AnsiString): TLandrixEInvoiceString;
var
  I, J, N: Integer;

  function Hex(C: AnsiChar): Integer;
  begin
    if C <= '9' then
      Result := Ord(C) - Ord('0')
    else
      Result := Ord(C) - Ord('A') + 10;
  end;

begin
  N := 0;
  I := 1;
  while I <= Length(S) do
  begin
    if S[I] = '\' then
      Inc(I, 5)
    else
      Inc(I);
    Inc(N);
  end;
  Result := '';
  SetLength(Result, N);
  I := 1;
  J := 1;
  while I <= Length(S) do
  begin
    if S[I] = '\' then
    begin
      Result[J] := WideChar(Hex(S[I + 1]) shl 12 + Hex(S[I + 2]) shl 8 + Hex(S[I + 3]) shl 4 + Hex(S[I + 4]));
      Inc(I, 5);
    end
    else
    begin
      Result[J] := WideChar(Ord(S[I]));
      Inc(I);
    end;
    Inc(J);
  end;
end;

{ ASCII case-insensitive; other characters must be equal }
function SameCode(const A: AnsiString; const B: TLandrixEInvoiceString): Boolean;
var
  I, X, Y: Integer;
begin
  Result := Length(A) = Length(B);
  I := 1;
  while Result and (I <= Length(A)) do
  begin
    X := Ord(A[I]);
    Y := Ord(B[I]);
    if (X >= Ord('a')) and (X <= Ord('z')) then
      Dec(X, 32);
    if (Y >= Ord('a')) and (Y <= Ord('z')) then
      Dec(Y, 32);
    Result := X = Y;
    Inc(I);
  end;
end;

function Find(const ANames: array of TCodeName; const ACode: TLandrixEInvoiceString;
  ALanguage: TLandrixEInvoiceReportLanguage): TLandrixEInvoiceString;
var
  I: Integer;
begin
  Result := '';
  if ACode = '' then
    Exit;
  { a while loop: High of an open array is 64-bit on Win64 }
  I := 0;
  while I <= High(ANames) do
  begin
    if SameCode(ANames[I].Code, ACode) then
    begin
      if (ALanguage = eln_German) and (ANames[I].De <> '') then
        Result := Decoded(ANames[I].De)
      else
        Result := Decoded(ANames[I].En);
      Exit;
    end;
    Inc(I);
  end;
end;

function LandrixEInvoiceCodeName(AList: TLandrixEInvoiceCodeList; const ACode: TLandrixEInvoiceString;
  ALanguage: TLandrixEInvoiceReportLanguage): TLandrixEInvoiceString;
begin
  case AList of
    ecl_TypeCode:
      Result := Find(TypeCodeNames, ACode, ALanguage);
    ecl_PaymentMeansCode:
      Result := Find(PaymentMeansCodeNames, ACode, ALanguage);
    ecl_UnitCode:
      Result := Find(UnitCodeNames, ACode, ALanguage);
    ecl_AllowanceOrChargeIdentCode:
      Result := Find(AllowanceOrChargeIdentCodeNames, ACode, ALanguage);
    ecl_SpecialServiceDescriptionCode:
      Result := Find(SpecialServiceDescriptionCodeNames, ACode, ALanguage);
    ecl_DutyTaxFeeCategoryCode:
      Result := Find(DutyTaxFeeCategoryCodeNames, ACode, ALanguage);
    ecl_NoteSubjectCode:
      Result := Find(NoteSubjectCodeNames, ACode, ALanguage);
    ecl_CountryCode:
      Result := Find(CountryCodeNames, ACode, ALanguage);
    ecl_CurrencyCode:
      Result := Find(CurrencyCodeNames, ACode, ALanguage);
    ecl_ElectronicAddressScheme:
      Result := Find(ElectronicAddressSchemeNames, ACode, ALanguage);
    ecl_IdentifierScheme:
      Result := Find(IdentifierSchemeNames, ACode, ALanguage);
    ecl_VATExemptionReasonCode:
      Result := Find(VATExemptionReasonCodeNames, ACode, ALanguage);
    ecl_ReferenceCodeQualifier:
      Result := Find(ReferenceCodeQualifierNames, ACode, ALanguage);
  else
    Result := Find(ItemClassificationSchemeNames, ACode, ALanguage);
  end;
end;

