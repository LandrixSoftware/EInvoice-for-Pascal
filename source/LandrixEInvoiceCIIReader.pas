          SkipUnknown;
      xttText, xttCData:
        if not FReader.IsWhitespace then
          Report(edk_UnexpectedText, 'unexpected text ignored');
    else
      ; { comments and processing instructions are skipped }
    end;
end;

procedure TCIIReader.ReadTradeTax(AObject: TLandrixCIITradeTax; AIsRoot: Boolean);
var
  Seen: array[0..10] of Boolean;
  I: Integer;
begin
  for I := Low(Seen) to High(Seen) do
    Seen[I] := False;
  CheckNoAttributes(AIsRoot);
  if FReader.IsEmptyElement then
  begin
    FReader.Read;
    Exit;
  end;
  while FReader.Read do
    case FReader.TokenType of
      xttEndElement:
        Break;
      xttStartElement:
        if IsElement(NS_RAM, 'CalculatedAmount') then
        begin
          if Seen[0] then
            SkipDuplicate
          else
          begin
            Seen[0] := True;
            ReadAmount(AObject.CalculatedAmount);
          end;
        end
        else if IsElement(NS_RAM, 'TypeCode') then
        begin
          if Seen[1] then
            SkipDuplicate
