function RunChecker(AInvoice: TLandrixCIIInvoice; AProfile: TLandrixEInvoiceProfile;
  const ARuleID: TLandrixEInvoiceString; ADiagnostics: TLandrixEInvoiceDiagnostics): Integer;
var
  Checker: TCIICodeChecker;
begin
  Result := 0;
  if not (AProfile in [epr_Minimum, epr_BasicWL, epr_Basic, epr_EN16931, epr_Extended]) then
    Exit;
  Checker := TCIICodeChecker.Create;
  try
    Checker.FProfile := AProfile;
    Checker.FRuleID := ARuleID;
    Checker.FDiagnostics := ADiagnostics;
    Checker.FInvoiceCurrency := AInvoice.SupplyChainTradeTransaction.ApplicableHeaderTradeSettlement.InvoiceCurrencyCode;
    Checker.FTaxCurrency := AInvoice.SupplyChainTradeTransaction.ApplicableHeaderTradeSettlement.TaxCurrencyCode;
    Checker.CheckInvoice(AInvoice, '/rsm:CrossIndustryInvoice');
    Result := Checker.FCount;
  finally
    Checker.Free;
  end;
end;

function LandrixEInvoiceCheckCIICodes(AInvoice: TLandrixCIIInvoice; AProfile: TLandrixEInvoiceProfile;
  ADiagnostics: TLandrixEInvoiceDiagnostics): Integer;
begin
  Result := RunChecker(AInvoice, AProfile, '', ADiagnostics);
end;

function LandrixEInvoiceCheckCIICodeRule(AInvoice: TLandrixCIIInvoice; AProfile: TLandrixEInvoiceProfile;
  const ARuleID: TLandrixEInvoiceString; ADiagnostics: TLandrixEInvoiceDiagnostics): Boolean;
var
  I: Integer;
begin
  I := Low(Rules);
  while (I <= High(Rules)) and (TLandrixEInvoiceString(Rules[I].ID) <> ARuleID) do
    Inc(I);
  if I > High(Rules) then
    raise ELandrixEInvoiceError.Create('LandrixEInvoiceCheckCIICodeRule: unknown rule ' + string(ARuleID));
  Result := RunChecker(AInvoice, AProfile, ARuleID, ADiagnostics) = 0;
end;

