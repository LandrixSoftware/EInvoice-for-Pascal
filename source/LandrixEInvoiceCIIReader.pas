          end;
        end
        else if IsElement(NS_RAM, 'RateApplicablePercent') then
        begin
          if Seen[10] then
            SkipDuplicate
          else
          begin
            Seen[10] := True;
            CheckNoAttributes(False);
            AObject.RateApplicablePercent := ReadLeaf('decimal');
          end;
        end
        else
          SkipUnknown;
      xttText, xttCData:
        if not FReader.IsWhitespace then
          Report(edk_UnexpectedText, 'unexpected text ignored');
    else
      ; { comments and processing instructions are skipped }
    end;
end;

