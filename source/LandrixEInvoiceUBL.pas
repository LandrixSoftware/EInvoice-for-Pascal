function TLandrixUBLCodeList.GetItem(Index: TLandrixEInvoiceListIndex): TLandrixUBLCode;
begin
  if (Index < 0) or (Index >= FCount) then
    raise ELandrixEInvoiceError.Create('TLandrixUBLCodeList index out of range');
  Result := FItems[Index];
end;

procedure TLandrixUBLCodeList.SetItem(Index: TLandrixEInvoiceListIndex; const AValue: TLandrixUBLCode);
begin
  if (Index < 0) or (Index >= FCount) then
    raise ELandrixEInvoiceError.Create('TLandrixUBLCodeList index out of range');
  FItems[Index] := AValue;
end;

procedure TLandrixUBLCodeList.Add(const AValue: TLandrixUBLCode);
begin
  if FCount = Length(FItems) then
    SetLength(FItems, FCount * 2 + 4);
  FItems[FCount] := AValue;
  Inc(FCount);
end;

procedure TLandrixUBLCodeList.Delete(Index: TLandrixEInvoiceListIndex);
var
  I: TLandrixEInvoiceListIndex;
begin
  if (Index < 0) or (Index >= FCount) then
    raise ELandrixEInvoiceError.Create('TLandrixUBLCodeList index out of range');
  for I := Index to FCount - 2 do
    FItems[I] := FItems[I + 1];
  Dec(FCount);
  UBLCodeClear(FItems[FCount]);
end;

procedure TLandrixUBLCodeList.Clear;
begin
  FItems := nil;
  FCount := 0;
end;

function TLandrixUBLIDList.GetItem(Index: TLandrixEInvoiceListIndex): TLandrixUBLID;
begin
  if (Index < 0) or (Index >= FCount) then
    raise ELandrixEInvoiceError.Create('TLandrixUBLIDList index out of range');
  Result := FItems[Index];
end;

procedure TLandrixUBLIDList.SetItem(Index: TLandrixEInvoiceListIndex; const AValue: TLandrixUBLID);
begin
  if (Index < 0) or (Index >= FCount) then
    raise ELandrixEInvoiceError.Create('TLandrixUBLIDList index out of range');
  FItems[Index] := AValue;
end;

procedure TLandrixUBLIDList.Add(const AValue: TLandrixUBLID);
begin
  if FCount = Length(FItems) then
    SetLength(FItems, FCount * 2 + 4);
  FItems[FCount] := AValue;
  Inc(FCount);
end;

procedure TLandrixUBLIDList.Delete(Index: TLandrixEInvoiceListIndex);
var
  I: TLandrixEInvoiceListIndex;
begin
  if (Index < 0) or (Index >= FCount) then
    raise ELandrixEInvoiceError.Create('TLandrixUBLIDList index out of range');
  for I := Index to FCount - 2 do
    FItems[I] := FItems[I + 1];
  Dec(FCount);
  UBLIDClear(FItems[FCount]);
end;

procedure TLandrixUBLIDList.Clear;
begin
  FItems := nil;
  FCount := 0;
end;

