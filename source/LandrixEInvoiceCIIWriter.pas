    WriteTradeDeliveryTerms(AObject.ApplicableTradeDeliveryTerms, APath + '/ram:ApplicableTradeDeliveryTerms');
    FWriter.EndElement;
  end;
  if not AObject.SellerOrderReferencedDocument.IsEmpty then
  begin
    FWriter.StartElement('ram:SellerOrderReferencedDocument');
