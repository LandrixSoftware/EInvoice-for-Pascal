  if FTaxExemptionReason = nil then
    FTaxExemptionReason := TLandrixEInvoiceStringList.Create;
  Result := FTaxExemptionReason;
end;

function TLandrixUBLTaxCategory.GetTaxScheme: TLandrixUBLTaxScheme;
begin
  if FTaxScheme = nil then
    FTaxScheme := TLandrixUBLTaxScheme.Create;
  Result := FTaxScheme;
end;

destructor TLandrixUBLTaxCategory.Destroy;
begin
  FTaxExemptionReason.Free;
  FTaxScheme.Free;
  inherited;
end;

procedure TLandrixUBLTaxCategory.Clear;
begin
  UBLIDClear(ID);
  Percent := '';
  UBLCodeClear(TaxExemptionReasonCode);
  FTaxExemptionReason.Free;
  FTaxExemptionReason := nil;
  FTaxScheme.Free;
  FTaxScheme := nil;
end;

function TLandrixUBLTaxCategory.IsEmpty: Boolean;
begin
  Result := UBLIDIsEmpty(ID) and
    LandrixEInvoiceIsBlank(Percent) and
    UBLCodeIsEmpty(TaxExemptionReasonCode) and
    ((FTaxExemptionReason = nil) or (FTaxExemptionReason.Count = 0)) and
    ((FTaxScheme = nil) or FTaxScheme.IsEmpty);
end;

procedure TLandrixUBLTaxCategory.ListFilledChildren(AList: TLandrixEInvoiceStringList);
begin
  if not UBLIDIsEmpty(ID) then
    AList.Add('cbc:ID');
  if not LandrixEInvoiceIsBlank(Percent) then
    AList.Add('cbc:Percent');
  if not UBLCodeIsEmpty(TaxExemptionReasonCode) then
    AList.Add('cbc:TaxExemptionReasonCode');
  if (FTaxExemptionReason <> nil) and (FTaxExemptionReason.Count > 0) then
    AList.Add('cbc:TaxExemptionReason');
  if (FTaxScheme <> nil) and not FTaxScheme.IsEmpty then
    AList.Add('cac:TaxScheme');
end;

{ TLandrixUBLTaxScheme }

destructor TLandrixUBLTaxScheme.Destroy;
begin
  inherited;
end;

procedure TLandrixUBLTaxScheme.Clear;
begin
  UBLIDClear(ID);
end;

function TLandrixUBLTaxScheme.IsEmpty: Boolean;
begin
  Result := UBLIDIsEmpty(ID);
end;

procedure TLandrixUBLTaxScheme.ListFilledChildren(AList: TLandrixEInvoiceStringList);
begin
  if not UBLIDIsEmpty(ID) then
    AList.Add('cbc:ID');
end;

{ TLandrixUBLTaxSubtotal }

function TLandrixUBLTaxSubtotal.GetTaxCategory: TLandrixUBLTaxCategory;
begin
  if FTaxCategory = nil then
    FTaxCategory := TLandrixUBLTaxCategory.Create;
  Result := FTaxCategory;
end;

destructor TLandrixUBLTaxSubtotal.Destroy;
begin
  FTaxCategory.Free;
  inherited;
end;

procedure TLandrixUBLTaxSubtotal.Clear;
begin
  UBLAmountClear(TaxableAmount);
  UBLAmountClear(TaxAmount);
  FTaxCategory.Free;
  FTaxCategory := nil;
end;

function TLandrixUBLTaxSubtotal.IsEmpty: Boolean;
begin
  Result := UBLAmountIsEmpty(TaxableAmount) and
    UBLAmountIsEmpty(TaxAmount) and
    ((FTaxCategory = nil) or FTaxCategory.IsEmpty);
end;

procedure TLandrixUBLTaxSubtotal.ListFilledChildren(AList: TLandrixEInvoiceStringList);
begin
  if not UBLAmountIsEmpty(TaxableAmount) then
    AList.Add('cbc:TaxableAmount');
  if not UBLAmountIsEmpty(TaxAmount) then
    AList.Add('cbc:TaxAmount');
  if (FTaxCategory <> nil) and not FTaxCategory.IsEmpty then
    AList.Add('cac:TaxCategory');
end;

{ TLandrixUBLTaxTotal }

function TLandrixUBLTaxTotal.GetTaxSubtotal: TLandrixUBLTaxSubtotalList;
begin
  if FTaxSubtotal = nil then
    FTaxSubtotal := TLandrixUBLTaxSubtotalList.Create;
  Result := FTaxSubtotal;
end;

destructor TLandrixUBLTaxTotal.Destroy;
begin
  FTaxSubtotal.Free;
  inherited;
end;

procedure TLandrixUBLTaxTotal.Clear;
begin
  UBLAmountClear(TaxAmount);
  FTaxSubtotal.Free;
  FTaxSubtotal := nil;
end;

function TLandrixUBLTaxTotal.IsEmpty: Boolean;
begin
  Result := UBLAmountIsEmpty(TaxAmount) and
    ((FTaxSubtotal = nil) or (FTaxSubtotal.Count = 0));
end;

procedure TLandrixUBLTaxTotal.ListFilledChildren(AList: TLandrixEInvoiceStringList);
begin
  if not UBLAmountIsEmpty(TaxAmount) then
    AList.Add('cbc:TaxAmount');
  if (FTaxSubtotal <> nil) and (FTaxSubtotal.Count > 0) then
    AList.Add('cac:TaxSubtotal');
end;

end.
