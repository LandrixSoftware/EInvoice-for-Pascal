  end;
  for I := 0 to AObject.ReceiptDocumentReference.Count - 1 do
  begin
    FWriter.StartElement('cac:ReceiptDocumentReference');
    WriteDocumentReference(AObject.ReceiptDocumentReference[I], APath + '/cac:ReceiptDocumentReference');
    FWriter.EndElement;
  end;
  for I := 0 to AObject.ContractDocumentReference.Count - 1 do
  begin
    FWriter.StartElement('cac:ContractDocumentReference');
    WriteDocumentReference(AObject.ContractDocumentReference[I], APath + '/cac:ContractDocumentReference');
