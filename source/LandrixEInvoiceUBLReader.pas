procedure TUBLReader.ReadStatus(AObject: TLandrixUBLStatus; AIsRoot: Boolean);
var
  Seen: array[0..11] of Boolean;
  I: Integer;
begin
  for I := Low(Seen) to High(Seen) do
    Seen[I] := False;
  CheckNoAttributes(AIsRoot);
  if FReader.IsEmptyElement then
  begin
    FReader.Read;
    Exit;
  end;
  while FReader.Read do
    case FReader.TokenType of
      xttEndElement:
        Break;
      xttStartElement:
        if IsElement(NS_CBC, 'ConditionCode') then
        begin
          if Seen[0] then
            SkipDuplicate
          else
          begin
            Seen[0] := True;
            ReadCode(AObject.ConditionCode);
          end;
        end
        else if IsElement(NS_CBC, 'ReferenceDate') then
        begin
          if Seen[1] then
            SkipDuplicate
