{ --- local corpus ------------------------------------------------------------ }

const
  KindNames: array[TLandrixEInvoicePdfAttachmentKind] of AnsiString = ('unspecified', 'invoice', 'otherxml', 'other');

function BoolText(B: Boolean): AnsiString;
begin
  if B then
    Result := 'True'
  else
    Result := 'False';
end;

function NameUtf8(const S: TLandrixEInvoiceString): AnsiString;
begin
  Result := Utf8Raw(LandrixEInvoiceStringToUtf8(S));
end;

type
  TRawLines = array of AnsiString;

{ Lines of a reference file (UTF-8 with byte order mark, CRLF) as raw bytes. }
function SplitLines(const AText: AnsiString): TRawLines;
var
  I, Start, N: Integer;
  S: AnsiString;
begin
  Result := nil;
  S := AText;
  if Copy(S, 1, 3) = #$EF#$BB#$BF then
    Delete(S, 1, 3);
  N := 0;
  Start := 1;
  for I := 1 to Length(S) do
    if S[I] = #10 then
    begin
      SetLength(Result, N + 1);
      if (I > Start) and (S[I - 1] = #13) then
        Result[N] := Copy(S, Start, I - Start - 1)
      else
        Result[N] := Copy(S, Start, I - Start);
      Inc(N);
      Start := I + 1;
    end;
end;

function LineValue(const ALines: TRawLines; const AKey: AnsiString): AnsiString;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to Integer(Length(ALines)) - 1 do
    if Copy(ALines[I], 1, Length(AKey) + 1) = AKey + '=' then
    begin
      Result := Copy(ALines[I], Length(AKey) + 2, MaxInt);
      Exit;
    end;
end;

{ One PDF against its reference: the info flags, every attachment with its
  bytes, and the chosen invoice. Returns '' or the first difference. }
function CompareWithReference(const APdf, AExpectedBase: string): string;
var
  Lines: TRawLines;
  List: TLandrixEInvoicePdfAttachmentList;
  Info: TLandrixEInvoicePdfExtractInfo;
  Ok: Boolean;
  I: TLandrixEInvoiceListIndex;
  Line, ExpectedLine: AnsiString;
  Xml: TMemoryStream;
  Name: TLandrixEInvoiceString;
  Diff: string;

  procedure Expect(const AKey, AActual: AnsiString);
  begin
    if (Diff = '') and (LineValue(Lines, AKey) <> AActual) then
      Diff := RawText(AKey) + ': expected "' + RawText(LineValue(Lines, AKey)) + '", got "' + RawText(AActual) + '"';
  end;

begin
  Diff := '';
  List := TLandrixEInvoicePdfAttachmentList.Create;
  Xml := TMemoryStream.Create;
  try
    Lines := SplitLines(LoadRaw(AExpectedBase + '.txt'));
    Ok := TLandrixEInvoicePdfExtractor.ExtractAllFromFile(APdf, List, Info);
    Expect('all', BoolText(Ok));
    Expect('reconstruction', BoolText(Info.UsedReconstruction));
    Expect('xrefsections', IntToAnsi(Info.XrefSections));
    Expect('encrypted', BoolText(Info.Encrypted));
    Expect('version', NameUtf8(Info.PdfVersion));
    Expect('count', IntToAnsi(Integer(List.Count)));
    for I := 0 to List.Count - 1 do
    begin
      Line := 'att=' + NameUtf8(List[I].FileName) + '|' + NameUtf8(List[I].Relationship) + '|' +
        NameUtf8(List[I].MimeType) + '|' + KindNames[List[I].Kind] + '|' + IntToAnsi(List[I].Size) + '|' +
        NameUtf8(List[I].RootElement) + '|';
      if 7 + Integer(I) < Length(Lines) then
        ExpectedLine := Lines[7 + Integer(I)]
      else
        ExpectedLine := '';
      if (Diff = '') and (Copy(ExpectedLine, 1, Length(Line)) <> Line) then
        Diff := 'attachment ' + IntToStr(I) + ': expected "' + RawText(ExpectedLine) + '", got "' + RawText(Line) + '"';
      if (Diff = '') and (StreamText(List[I].Data) <> LoadRaw(AExpectedBase + '.' + IntToStr(I) + '.bin')) then
        Diff := 'attachment ' + IntToStr(I) + ': different bytes';
    end;
    Expect('invoiceindex', IntToAnsi(Integer(TLandrixEInvoicePdfExtractor.FindInvoiceIndex(List))));
    Ok := TLandrixEInvoicePdfExtractor.ExtractInvoiceFromFile(APdf, Xml, Name, Info);
    Expect('invoice', BoolText(Ok));
    Expect('invoicename', NameUtf8(Name));
    if Ok and (Diff = '') and (StreamText(Xml) <> LoadRaw(AExpectedBase + '.xml')) then
      Diff := 'invoice: different bytes';
  finally
    Xml.Free;
    List.Free;
  end;
  Result := Diff;
end;

procedure TestCorpus;
var
  Dir: string;
  SR: TSearchRec;
  Base, Diff: string;
  Files, Failed: Integer;
  First: string;
begin
  Dir := RepositoryRoot + 'tests' + PathDelim + 'data' + PathDelim + 'local' + PathDelim + 'pdf' + PathDelim;
  if not FileExists(Dir + 'index.txt') then
  begin
    Skip('no local PDF corpus in ' + Dir);
    Exit;
  end;
  Files := 0;
  Failed := 0;
  First := '';
  if FindFirst(Dir + '*.pdf', faAnyFile, SR) = 0 then
    try
      repeat
        Base := Dir + 'expected' + PathDelim + ChangeFileExt(SR.Name, '');
        if not FileExists(Base + '.txt') then
          Continue;
        Inc(Files);
        Diff := CompareWithReference(Dir + SR.Name, Base);
        if Diff <> '' then
        begin
          Inc(Failed);
          if First = '' then
            First := SR.Name + ': ' + Diff;
          WriteLn('  ', SR.Name, ': ', Diff);
        end;
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
  Check(Files > 0, 'corpus without reference results');
  CheckEquals(0, Failed, IntToStr(Failed) + ' of ' + IntToStr(Files) + ' PDFs differ, first: ' + First);
end;

procedure Register;
begin
  RegisterTest('Pdf.Detection', TestDetection);
  RegisterTest('Pdf.Filters', TestFilters);
  RegisterTest('Pdf.DamagedStreams', TestDamagedStreams);
  RegisterTest('Pdf.Structure', TestStructure);
  RegisterTest('Pdf.IncrementalUpdate', TestIncrementalUpdate);
  RegisterTest('Pdf.HybridXref', TestHybridXref);
  RegisterTest('Pdf.Encryption', TestEncryption);
  RegisterTest('Pdf.Corpus', TestCorpus);
end;

end.
