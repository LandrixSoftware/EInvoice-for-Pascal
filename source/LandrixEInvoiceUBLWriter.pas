  begin
    FWriter.StartElement('cac:InvoicePeriod');
    WritePeriod(AObject.InvoicePeriod[I], APath + '/cac:InvoicePeriod');
    FWriter.EndElement;
  end;
  for I := 0 to AObject.DiscrepancyResponse.Count - 1 do
  begin
    FWriter.StartElement('cac:DiscrepancyResponse');
    WriteResponse(AObject.DiscrepancyResponse[I], APath + '/cac:DiscrepancyResponse');
