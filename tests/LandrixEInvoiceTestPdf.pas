{ --- local corpus ------------------------------------------------------------ }

const
  KindNames: array[TLandrixEInvoicePdfAttachmentKind] of AnsiString = ('unspecified', 'invoice', 'otherxml', 'other');

function BoolText(B: Boolean): AnsiString;
begin
  if B then
    Result := 'True'
  else
    Result := 'False';
end;

function NameUtf8(const S: TLandrixEInvoiceString): AnsiString;
begin
  Result := Utf8Raw(LandrixEInvoiceStringToUtf8(S));
end;

type
  TRawLines = array of AnsiString;

{ Lines of a reference file (UTF-8 with byte order mark, CRLF) as raw bytes. }
function SplitLines(const AText: AnsiString): TRawLines;
var
  I, Start, N: Integer;
  S: AnsiString;
begin
  Result := nil;
  S := AText;
  if Copy(S, 1, 3) = #$EF#$BB#$BF then
    Delete(S, 1, 3);
  N := 0;
  Start := 1;
  for I := 1 to Length(S) do
    if S[I] = #10 then
    begin
      SetLength(Result, N + 1);
      if (I > Start) and (S[I - 1] = #13) then
        Result[N] := Copy(S, Start, I - Start - 1)
      else
        Result[N] := Copy(S, Start, I - Start);
      Inc(N);
      Start := I + 1;
    end;
end;

function LineValue(const ALines: TRawLines; const AKey: AnsiString): AnsiString;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to Integer(Length(ALines)) - 1 do
    if Copy(ALines[I], 1, Length(AKey) + 1) = AKey + '=' then
    begin
      Result := Copy(ALines[I], Length(AKey) + 2, MaxInt);
      Exit;
    end;
end;

{ One PDF against its reference: the info flags, every attachment with its
  bytes, and the chosen invoice. Returns '' or the first difference. }
function CompareWithReference(const APdf, AExpectedBase: string): string;
var
  Lines: TRawLines;
  List: TLandrixEInvoicePdfAttachmentList;
  Info: TLandrixEInvoicePdfExtractInfo;
  Ok: Boolean;
  I: TLandrixEInvoiceListIndex;
  Line, ExpectedLine: AnsiString;
  Xml: TMemoryStream;
  Name: TLandrixEInvoiceString;
  Diff: string;

  procedure Expect(const AKey, AActual: AnsiString);
  begin
    if (Diff = '') and (LineValue(Lines, AKey) <> AActual) then
      Diff := RawText(AKey) + ': expected "' + RawText(LineValue(Lines, AKey)) + '", got "' + RawText(AActual) + '"';
  end;

begin
  Diff := '';
  List := TLandrixEInvoicePdfAttachmentList.Create;
  Xml := TMemoryStream.Create;
  try
    Lines := SplitLines(LoadRaw(AExpectedBase + '.txt'));
    Ok := TLandrixEInvoicePdfExtractor.ExtractAllFromFile(APdf, List, Info);
    Expect('all', BoolText(Ok));
    Expect('reconstruction', BoolText(Info.UsedReconstruction));
    Expect('xrefsections', IntToAnsi(Info.XrefSections));
    Expect('encrypted', BoolText(Info.Encrypted));
    Expect('version', NameUtf8(Info.PdfVersion));
    Expect('count', IntToAnsi(Integer(List.Count)));
    for I := 0 to List.Count - 1 do
    begin
      Line := 'att=' + NameUtf8(List[I].FileName) + '|' + NameUtf8(List[I].Relationship) + '|' +
        NameUtf8(List[I].MimeType) + '|' + KindNames[List[I].Kind] + '|' + IntToAnsi(List[I].Size) + '|' +
        NameUtf8(List[I].RootElement) + '|';
      if 7 + Integer(I) < Length(Lines) then
        ExpectedLine := Lines[7 + Integer(I)]
      else
        ExpectedLine := '';
      if (Diff = '') and (Copy(ExpectedLine, 1, Length(Line)) <> Line) then
        Diff := 'attachment ' + IntToStr(I) + ': expected "' + RawText(ExpectedLine) + '", got "' + RawText(Line) + '"';
      if (Diff = '') and (StreamText(List[I].Data) <> LoadRaw(AExpectedBase + '.' + IntToStr(I) + '.bin')) then
        Diff := 'attachment ' + IntToStr(I) + ': different bytes';
    end;
    Expect('invoiceindex', IntToAnsi(Integer(TLandrixEInvoicePdfExtractor.FindInvoiceIndex(List))));
    Ok := TLandrixEInvoicePdfExtractor.ExtractInvoiceFromFile(APdf, Xml, Name, Info);
    Expect('invoice', BoolText(Ok));
    Expect('invoicename', NameUtf8(Name));
    if Ok and (Diff = '') and (StreamText(Xml) <> LoadRaw(AExpectedBase + '.xml')) then
      Diff := 'invoice: different bytes';
  finally
    Xml.Free;
    List.Free;
  end;
  Result := Diff;
end;

procedure TestCorpus;
var
  Dir: string;
  SR: TSearchRec;
  Base, Diff: string;
  Files, Failed: Integer;
  First: string;
begin
  Dir := RepositoryRoot + 'tests' + PathDelim + 'data' + PathDelim + 'local' + PathDelim + 'pdf' + PathDelim;
  if not FileExists(Dir + 'index.txt') then
  begin
    Skip('no local PDF corpus in ' + Dir);
    Exit;
  end;
  Files := 0;
  Failed := 0;
  First := '';
  if FindFirst(Dir + '*.pdf', faAnyFile, SR) = 0 then
    try
      repeat
        Base := Dir + 'expected' + PathDelim + ChangeFileExt(SR.Name, '');
        if not FileExists(Base + '.txt') then
          Continue;
        Inc(Files);
        Diff := CompareWithReference(Dir + SR.Name, Base);
        if Diff <> '' then
        begin
          Inc(Failed);
          if First = '' then
            First := SR.Name + ': ' + Diff;
          WriteLn('  ', SR.Name, ': ', Diff);
        end;
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
  Check(Files > 0, 'corpus without reference results');
  CheckEquals(0, Failed, IntToStr(Failed) + ' of ' + IntToStr(Files) + ' PDFs differ, first: ' + First);
end;

{ --- the collector of the object layer ---------------------------------------- }

function LoadDocument(const APdf: AnsiString): TLandrixEInvoicePdfDocument;
var
  S: TMemoryStream;
  Error: string;
begin
  Result := TLandrixEInvoicePdfDocument.Create;
  S := TMemoryStream.Create;
  try
    try
      if APdf <> '' then
        S.WriteBuffer(APdf[1], Length(APdf));
      S.Position := 0;
      Check(Result.Load(S, Error), 'load: ' + Error);
    except
      Result.Free;
      raise;
    end;
  finally
    S.Free;
  end;
end;

procedure TestCollector;
var
  Pdf: AnsiString;
  O: TPdfOffsets;
  Doc: TLandrixEInvoicePdfDocument;
  Specs: TLandrixEInvoicePdfCollector;
  F: TLandrixEInvoicePdfFileSpec;
  InfoDict, Meta: TLandrixEInvoicePdfObject;
  List: TLandrixEInvoicePdfAttachmentList;
  Info: TLandrixEInvoicePdfExtractInfo;
begin
  { the standard case: name tree and /AF point to the same file specification }
  Doc := LoadDocument(InvoicePdf('/Params << /Size 10 /ModDate (D:20261027120000+01''00) >>', '<Invoice/>'));
  Specs := TLandrixEInvoicePdfCollector.Create(Doc);
  try
    Specs.Collect;
    Check(Specs.HasNameTree and Specs.HasAF, 'name tree and /AF');
    CheckEquals(1, Specs.Count, 'one file specification');
    F := Specs[0];
    Check(F.Routes = [efr_NameTree, efr_AF], 'both routes');
    CheckEqualsStr('/Root/Names/EmbeddedFiles/Names[1]', string(F.NameTreePath), 'path in the name tree');
    CheckEqualsInvoiceStr('factur-x.xml', F.NameTreeKey, 'key');
    CheckEquals(1, F.NameTreeCount, 'listed once');
    CheckEquals(0, F.AFIndex, 'index in /AF');
    CheckEquals(4, F.SpecNum, 'object number of the file specification');
    CheckEqualsBytes('Filespec', F.TypeName, '/Type');
    Check(F.HasF and F.HasUF, '/F and /UF');
    CheckEqualsInvoiceStr('factur-x.xml', F.FileName, 'file name');
    Check(F.HasRelationship, '/AFRelationship present');
    CheckEqualsBytes('Alternative', F.Relationship, '/AFRelationship');
    Check(F.HasEmbeddedF and not F.HasEmbeddedUF, '/EF /F only');
    CheckEquals(5, F.StreamNum, 'object number of the stream');
    CheckEqualsBytes('EmbeddedFile', F.StreamType, 'stream /Type');
    CheckEqualsBytes('text/xml', F.Subtype, '/Subtype decoded');
    Check(F.HasParams and F.HasModDate, '/Params with /ModDate');
    CheckEquals(10, Integer(F.ParamsSize), '/Params /Size');
    CheckEqualsInvoiceStr('D:20261027120000+01''00', F.ModDate, '/ModDate');
    CheckEquals(-1, F.DuplicateOf, 'no duplicate');
    CheckEquals(0, Specs.NameTreeIssues.Count, 'root without /Limits is fine');
  finally
    Specs.Free;
    Doc.Free;
  end;

  { two file specifications on one stream, keys out of order, wrong /Limits,
    no /AF; trailer /Info, catalog /Metadata and /Version }
  O := NoOffsets;
  Pdf := PdfHeader;
  AddObj(Pdf, O, 1, '<< /Type /Catalog /Pages 2 0 R /Version /2.0 /Metadata 8 0 R ' +
    '/Names << /EmbeddedFiles << /Kids [6 0 R] >> >> >>');
  AddObj(Pdf, O, 2, PagesBody);
  AddObj(Pdf, O, 3, PageBody);
  AddObj(Pdf, O, 4, '<< /Type /Filespec /F (b.xml) /EF << /F 5 0 R >> >>');
  AddObj(Pdf, O, 5, StreamBody('/Type /EmbeddedFile', '<Invoice/>'));
  AddObj(Pdf, O, 6, '<< /Limits [(a) (z)] /Names [(b) 4 0 R (a) 7 0 R] >>');
  AddObj(Pdf, O, 7, '<< /F (a.xml) /EF << /UF 5 0 R >> >>');
  AddObj(Pdf, O, 8, StreamBody('/Type /Metadata /Subtype /XML', '<x:xmpmeta xmlns:x="adobe:ns:meta/"/>'));
  AddObj(Pdf, O, 9, '<< /Title (T) >>');
  Finish(Pdf, O, 10, ' /Info 9 0 R');
  Doc := LoadDocument(Pdf);
  Specs := TLandrixEInvoicePdfCollector.Create(Doc);
  try
    Specs.Collect;
    Check(Specs.HasNameTree and not Specs.HasAF, 'no /AF');
    CheckEquals(2, Specs.Count, 'two file specifications');
    Check(Specs[1].Routes = [efr_NameTree], 'name tree only');
    CheckEqualsStr('/Root/Names/EmbeddedFiles/Kids[0]/Names[3]', string(Specs[1].NameTreePath), 'path below a kid');
    CheckEquals(0, Specs[1].DuplicateOf, 'same stream as the first');
    Check(not Specs[1].HasUF and (Specs[1].TypeName = ''), 'no /UF, no /Type');
    Check(not Specs[1].HasEmbeddedF and Specs[1].HasEmbeddedUF, '/EF /UF only');
    Check(not Specs[1].HasRelationship, 'no /AFRelationship');
    CheckEquals(-1, Integer(Specs[1].ParamsSize), 'no /Size');
    CheckEquals(2, Specs.NameTreeIssues.Count, 'issues: ' + Specs.NameTreeIssues.Text);
    Check(Pos('/Kids[0]/Names[2]: key not in ascending lexical order', Specs.NameTreeIssues.Text) > 0, 'order');
    Check(Pos('/Kids[0]/Limits: do not match', Specs.NameTreeIssues.Text) > 0, 'limits');
    CheckEqualsBytes('2.0', Doc.CatalogVersion, 'catalog /Version');
    Meta := Doc.Metadata;
    Check((Meta <> nil) and (Meta.Kind = pok_Stream), '/Metadata stream');
    InfoDict := Doc.Info;
    Check((InfoDict <> nil) and (Doc.DGet(InfoDict, 'Title') <> nil), 'trailer /Info');
  finally
    Specs.Free;
    Doc.Free;
  end;

  { only in /AF; without /EF; /EF /F leads nowhere (falls back to /UF), /EF
    /DOS only; a kid without /Limits; /Params without /ModDate }
  O := NoOffsets;
  Pdf := PdfHeader;
  AddObj(Pdf, O, 1, '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles << /Kids [6 0 R] >> >> ' +
    '/AF [4 0 R 7 0 R 8 0 R] >>');
  AddObj(Pdf, O, 2, PagesBody);
  AddObj(Pdf, O, 3, PageBody);
  AddObj(Pdf, O, 4, '<< /Type /Filespec /F (a.xml) >>');
  AddObj(Pdf, O, 5, StreamBody('/Type /EmbeddedFile /Params << /Size 10 >>', '<Invoice/>'));
  AddObj(Pdf, O, 6, '<< /Names [(k) 9 0 R] >>');
  AddObj(Pdf, O, 7, '<< /Type /Filespec /F (b.xml) /EF << /F 15 0 R /UF 5 0 R >> >>');
  AddObj(Pdf, O, 8, '<< /Type /Filespec /F (c.xml) /EF << /DOS 10 0 R >> >>');
  AddObj(Pdf, O, 9, '<< /Type /Filespec /F (k.xml) >>');
  AddObj(Pdf, O, 10, StreamBody('/Type /EmbeddedFile', '<CreditNote/>'));
  Finish(Pdf, O, 11, '');
  Doc := LoadDocument(Pdf);
  Specs := TLandrixEInvoicePdfCollector.Create(Doc);
  try
    Specs.Collect;
    CheckEquals(4, Specs.Count, 'four file specifications');
    Check(Specs[0].Routes = [efr_NameTree], 'name tree first');
    Check(Specs[1].Routes = [efr_AF], 'then /AF only');
    CheckEquals(0, Specs[1].AFIndex, 'index in /AF');
    Check(Specs[1].Stream = nil, 'no /EF, no stream');
    Check(Specs[2].HasEmbeddedF and (Specs[2].StreamNum = 5), '/EF /F leads nowhere: /UF');
    Check(Specs[2].HasParams and not Specs[2].HasModDate and (Specs[2].ParamsSize = 10), '/Params without /ModDate');
    CheckEquals(10, Specs[3].StreamNum, '/EF /DOS');
    CheckEquals(1, Specs.NameTreeIssues.Count, 'issues: ' + Specs.NameTreeIssues.Text);
    Check(Pos('/Kids[0]: no /Limits', Specs.NameTreeIssues.Text) > 0, 'kid without /Limits');
  finally
    Specs.Free;
    Doc.Free;
  end;
  List := TLandrixEInvoicePdfAttachmentList.Create;
  try
    Check(ExtractAll(Pdf, List, Info), 'extract');
    CheckEquals(2, Integer(List.Count), 'specifications without stream left out');
    CheckEqualsInvoiceStr('b.xml', List[0].FileName, 'first with stream');
    CheckEqualsInvoiceStr('c.xml', List[1].FileName, 'then /DOS');
  finally
    List.Free;
  end;

  { a document without /Info, /Metadata and /Version }
  Doc := LoadDocument(BuildInvoicePdf('<Invoice/>'));
  try
    Check((Doc.Info = nil) and (Doc.Metadata = nil) and (Doc.CatalogVersion = ''), 'all absent');
  finally
    Doc.Free;
  end;
end;

{ --- the checker of level 2 ------------------------------------------------------ }

const
  CheckXml = '<rsm:CrossIndustryInvoice xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100"/>';
  GoodParams = '/Params << /Size 100 /ModDate (D:20261028120000+01''00) >>';

{ --- level 3 ------------------------------------------------------------------ }

function RawReplace(const S, AOld, ANew: AnsiString): AnsiString;
var
  P: Integer;
begin
  P := RawPos(AOld, S);
  Check(P > 0, 'RawReplace: "' + RawText(AOld) + '" not found');
  if P = 0 then
    Result := S
  else
    Result := Copy(S, 1, P - 1) + ANew + Copy(S, P + Length(AOld), MaxInt);
end;

{ An XMP packet as the writer side builds it: pdfaid, the extension schema
  LandrixEInvoicePdfXmpSchema and LandrixEInvoicePdfXmpDescription of
  ATarget. }
function XmpPacket(const ATarget: TLandrixEInvoiceTarget): AnsiString;
begin
  Result := '<?xpacket begin="" id="W5M0MpCehiHzreSzNTczkc9d"?>'#10 +
    '<x:xmpmeta xmlns:x="adobe:ns:meta/"><rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">'#10 +
    '<rdf:Description xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/" rdf:about="">' +
    '<pdfaid:part>3</pdfaid:part><pdfaid:conformance>B</pdfaid:conformance></rdf:Description>'#10 +
    '<rdf:Description xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/" ' +
    'xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#" xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#" ' +
    'rdf:about=""><pdfaExtension:schemas><rdf:Bag>'#10 +
    Utf8Raw(LandrixEInvoiceStringToUtf8(TLandrixEInvoiceString(LandrixEInvoicePdfXmpSchema))) +
    #10'</rdf:Bag></pdfaExtension:schemas></rdf:Description>'#10 +
    Utf8Raw(LandrixEInvoiceStringToUtf8(LandrixEInvoicePdfXmpDescription(ATarget))) +
    #10'</rdf:RDF></x:xmpmeta>'#10'<?xpacket end="w"?>';
end;

function GoodXmp: AnsiString;
begin
  Result := XmpPacket(TLandrixEInvoiceTargets.FacturX('1.09', epr_EN16931));
end;

{ Number of level 3 findings: their paths start with "XMP " or are
  /Root/Metadata. }
function IsMetadataFinding(D: TLandrixEInvoiceDiagnostic): Boolean;
begin
  Result := (Copy(string(D.Path), 1, 4) = 'XMP ') or (string(D.Path) = '/Root/Metadata');
end;

function MetadataCount(AResult: TLandrixEInvoicePdfCheckResult): Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to Integer(AResult.Diagnostics.Count) - 1 do
    if IsMetadataFinding(AResult.Diagnostics[I]) then
      Inc(Result);
end;

{ Level 2 findings: all others. }
function EmbeddingCount(AResult: TLandrixEInvoicePdfCheckResult): Integer;
begin
  Result := Integer(AResult.Diagnostics.Count) - MetadataCount(AResult);
end;

function EmbeddingErrors(AResult: TLandrixEInvoicePdfCheckResult): Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to Integer(AResult.Diagnostics.Count) - 1 do
    if not IsMetadataFinding(AResult.Diagnostics[I]) and (AResult.Diagnostics[I].Severity = eds_Error) then
      Inc(Result);
end;

{ Catalog 1 with ACatalogExtra (the name tree, /AF), pages 2, page 3,
  file specification 4 with the body ASpec, embedded file 5 with the stream
  dictionary entries AStreamDict and the data AData, and the XMP packet AXmp
  as /Metadata 6 (none if AXmp is ''). SimplePdf uses GoodXmp. }
function SimplePdfX(const ACatalogExtra, ASpec, AStreamDict, AData, AXmp: AnsiString): AnsiString;
var
  O: TPdfOffsets;
begin
  O := NoOffsets;
  Result := PdfHeader;
  if AXmp = '' then
    AddObj(Result, O, 1, '<< /Type /Catalog /Pages 2 0 R ' + ACatalogExtra + ' >>')
  else
    AddObj(Result, O, 1, '<< /Type /Catalog /Pages 2 0 R /Metadata 6 0 R ' + ACatalogExtra + ' >>');
  AddObj(Result, O, 2, PagesBody);
  AddObj(Result, O, 3, PageBody);
  AddObj(Result, O, 4, ASpec);
  AddObj(Result, O, 5, StreamBody(AStreamDict, AData));
  if AXmp = '' then
    Finish(Result, O, 6, '')
  else
  begin
    AddObj(Result, O, 6, StreamBody('/Type /Metadata /Subtype /XML', AXmp));
    Finish(Result, O, 7, '');
  end;
end;

function SimplePdf(const ACatalogExtra, ASpec, AStreamDict, AData: AnsiString): AnsiString;
begin
  Result := SimplePdfX(ACatalogExtra, ASpec, AStreamDict, AData, GoodXmp);
end;

const
  TreeAndAF = '/Names << /EmbeddedFiles << /Names [(factur-x.xml) 4 0 R] >> >> /AF [4 0 R]';
  GoodSpec = '<< /Type /Filespec /F (factur-x.xml) /UF (factur-x.xml) /EF << /F 5 0 R >> ' +
    '/AFRelationship /Alternative >>';
  GoodStream = '/Type /EmbeddedFile /Subtype /text#2Fxml ' + GoodParams;

function RunCheck(const APdf: AnsiString; AResult: TLandrixEInvoicePdfCheckResult): Integer;
var
  S: TMemoryStream;
  Checker: TLandrixEInvoicePdfChecker;
begin
  S := TMemoryStream.Create;
  Checker := TLandrixEInvoicePdfChecker.Create;
  try
    if APdf <> '' then
      S.WriteBuffer(APdf[1], Length(APdf));
    S.Position := 0;
    Result := Checker.CheckStream(S, AResult);
  finally
    Checker.Free;
    S.Free;
  end;
end;

{ Number of findings of rule ARule whose path and message contain AText. }
function Findings(AResult: TLandrixEInvoicePdfCheckResult; const ARule, AText: string): Integer;
var
  I: Integer;
  D: TLandrixEInvoiceDiagnostic;
begin
  Result := 0;
  for I := 0 to Integer(AResult.Diagnostics.Count) - 1 do
  begin
    D := AResult.Diagnostics[I];
    if (string(D.RuleID) = ARule) and (Pos(AText, string(D.Path + ' ' + D.Message)) > 0) then
      Inc(Result);
  end;
end;

function StatusText(AResult: TLandrixEInvoicePdfCheckResult): string;
const
  Names: array[TLandrixEInvoicePdfLevelStatus] of string = ('not run', 'passed', 'failed', 'incomplete');
begin
  Result := Names[AResult.Status[epl_Embedding]] + ': ' + string(AResult.Diagnostics.ToText);
end;

{ Level 2 only: level 3 findings are not counted. }
procedure CheckOnly(AResult: TLandrixEInvoicePdfCheckResult; const APdf: AnsiString;
  AStatus: TLandrixEInvoicePdfLevelStatus; const ARule, AText, Msg: string);
var
  Errors: Integer;
begin
  RunCheck(APdf, AResult);
  Errors := EmbeddingErrors(AResult);
  Check(AResult.Status[epl_Embedding] = AStatus, Msg + ': status ' + StatusText(AResult));
  CheckEquals(1, EmbeddingCount(AResult), Msg + ': one finding: ' + StatusText(AResult));
  CheckEquals(1, Findings(AResult, ARule, AText), Msg + ': ' + ARule + ' ' + AText);
  if AStatus = eps_Failed then
    CheckEquals(1, Errors, Msg + ': errors')
  else
    CheckEquals(0, Errors, Msg + ': errors');
end;

procedure TestCheckEmbedding;
var
  R: TLandrixEInvoicePdfCheckResult;
  O: TPdfOffsets;
  Pdf: AnsiString;
  I: Integer;
begin
  Check(Length(CheckXml) = 100, 'the /Size of GoodParams is the length of CheckXml');
  R := TLandrixEInvoicePdfCheckResult.Create;
  try
    { the reference case: no finding }
    CheckEquals(0, RunCheck(SimplePdf(TreeAndAF, GoodSpec, GoodStream, CheckXml), R), 'no errors');
    Check(R.Status[epl_Embedding] = eps_Passed, 'passed: ' + StatusText(R));
    CheckEquals(0, EmbeddingCount(R), 'no findings: ' + StatusText(R));
    Check(R.Status[epl_PdfA] = eps_NotRun, 'level 1 not run');
    Check(R.HybridKind = ehk_FacturX, 'Factur-X');
    CheckEqualsInvoiceStr('factur-x.xml', R.InvoiceFileName, 'file name');
    CheckEqualsInvoiceStr('Alternative', R.InvoiceRelationship, 'relationship');
    CheckEqualsInvoiceStr('1.7', R.PdfVersion, 'header version');
    CheckEqualsInvoiceStr('', R.CatalogVersion, 'no catalog version');
    CheckEqualsBytes(CheckXml, StreamText(R.Invoice), 'invoice bytes');

    { recommendations and the general table }
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, '/Type /EmbeddedFile /Subtype /text#2Fxml', CheckXml),
      eps_Passed, 'LX-PDF-04', '/Root/Names/EmbeddedFiles/Names[1]/EF/F/Params', 'no /ModDate');
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, GoodStream, CheckXml + ' '),
      eps_Passed, 'LX-PDF-05', 'decoded length 101', 'wrong /Size');
    CheckOnly(R, SimplePdf(TreeAndAF, '<< /Type /Filespec /F (factur-x.xml) /UF (factur-x.xml) /EF << /F 5 0 R >> ' +
      '/AFRelationship /Unspecified >>', GoodStream, CheckXml),
      eps_Passed, 'BR-HYBRID-11', '/Unspecified', 'relationship outside the table');
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, '/Type /EmbeddedFile /Subtype /text#2Fxml /Params << /ModDate (D:2026) >>',
      '<?xml version="1.0" encoding="ISO-8859-1"?>' + CheckXml),
      eps_Passed, 'LX-PDF-06', 'ISO-8859-1', 'not UTF-8');

    { the file name, exactly }
    RunCheck(SimplePdf('/Names << /EmbeddedFiles << /Names [(Factur-X.xml) 4 0 R] >> >> /AF [4 0 R]',
      '<< /Type /Filespec /F (Factur-X.xml) /UF (Factur-X.xml) /EF << /F 5 0 R >> /AFRelationship /Alternative >>',
      GoodStream, CheckXml), R);
    Check(R.Status[epl_Embedding] = eps_Failed, 'wrong case: ' + StatusText(R));
    CheckEquals(2, Findings(R, 'BR-HYBRID-13', '"Factur-X.xml"'), '/F and /UF: ' + StatusText(R));
    CheckEquals(2, EmbeddingCount(R), 'nothing else: ' + StatusText(R));
    Check(R.HybridKind = ehk_FacturX, 'still Factur-X');
    RunCheck(SimplePdf('/Names << /EmbeddedFiles << /Names [(invoice.xml) 4 0 R] >> >> /AF [4 0 R]',
      '<< /Type /Filespec /F (invoice.xml) /UF (xrechnung.xml) /EF << /F 5 0 R >> /AFRelationship /Alternative >>',
      GoodStream, CheckXml), R);
    CheckEquals(1, Findings(R, 'BR-HYBRID-13', 'Names[1]/F The file name "invoice.xml"'), 'by the root element: ' +
      StatusText(R));
    Check(R.HybridKind = ehk_XRechnung, 'XRechnung by /UF');

    { the file specification }
    RunCheck(SimplePdf(TreeAndAF, '<< /F (factur-x.xml) /EF << /UF 5 0 R >> >>', GoodStream, CheckXml), R);
    Check(R.Status[epl_Embedding] = eps_Failed, 'damaged file specification: ' + StatusText(R));
    CheckEquals(1, Findings(R, 'BR-HYBRID-12', 'no /Type /Filespec'), '/Type');
    CheckEquals(1, Findings(R, 'BR-HYBRID-12', 'no /UF'), '/UF');
    CheckEquals(1, Findings(R, 'BR-HYBRID-12', 'no /AFRelationship'), '/AFRelationship');
    CheckEquals(1, Findings(R, 'BR-HYBRID-12', 'not under /EF /F'), '/EF /F');
    CheckEquals(4, EmbeddingCount(R), 'nothing else: ' + StatusText(R));
    CheckEqualsBytes(CheckXml, StreamText(R.Invoice), 'still extracted');
    CheckOnly(R, SimplePdf(TreeAndAF, '<< /Type /Filespec /F (factur-x.xml) /UF (factur-x.xml) /AFRelationship /Data >>',
      GoodStream, CheckXml), eps_Failed, 'BR-HYBRID-12', 'no embedded file stream', 'no /EF');
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, '/Type /EmbeddedFile /Subtype /application#2Fxml ' + GoodParams,
      CheckXml), eps_Passed, 'LX-PDF-09', 'application/xml', 'application/xml');
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, '/Type /EmbeddedFile /Subtype /text#2Fplain ' + GoodParams,
      CheckXml), eps_Failed, 'BR-HYBRID-12', 'text/plain, not text/xml', 'MIME type');
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, '/Type /EmbeddedFile ' + GoodParams,
      CheckXml), eps_Failed, 'BR-HYBRID-12', 'no /Subtype', 'no MIME type');
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, '/Type /XObject /Subtype /text#2Fxml ' + GoodParams,
      CheckXml), eps_Failed, 'BR-HYBRID-12', '/XObject', 'stream /Type');
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, GoodStream + ' /Filter /FlateDecode', CheckXml),
      eps_Failed, 'BR-HYBRID-12', 'cannot be decoded', 'damaged stream');
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, '/Type /EmbeddedFile /Subtype /text#2Fxml /Params << /ModDate (D:2026) >>',
      '<rsm:CrossIndustryInvoice xmlns:rsm="urn:x"><a></b></rsm:CrossIndustryInvoice>'),
      eps_Failed, 'BR-HYBRID-12', 'factur-x.xml:/rsm:CrossIndustryInvoice', 'not well-formed');
    Check(R.Diagnostics[0].Line = 1, 'line of the XML error');
    Check(R.Diagnostics[0].Column > 40, 'column of the XML error');

    { the ways to the file }
    CheckOnly(R, SimplePdf('/Names << /EmbeddedFiles << /Names [(factur-x.xml) 4 0 R] >> >>', GoodSpec, GoodStream,
      CheckXml), eps_Failed, 'BR-HYBRID-12', 'no /AF array', 'no /AF');
    CheckOnly(R, SimplePdf('/AF [4 0 R]', GoodSpec, GoodStream, CheckXml), eps_Failed, 'BR-HYBRID-12',
      'no name tree', 'no name tree');
    CheckOnly(R, SimplePdf('/Names << /EmbeddedFiles << /Names [(factur-x.xml) 4 0 R] >> >> /AF []', GoodSpec,
      GoodStream, CheckXml), eps_Failed, 'BR-HYBRID-12', 'not listed in /AF', 'empty /AF');
    O := NoOffsets;
    Pdf := PdfHeader;
    AddObj(Pdf, O, 1, '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles << /Names [(z.xml) 6 0 R ' +
      '(factur-x.xml) 4 0 R] >> >> /AF [4 0 R 6 0 R] >>');
    AddObj(Pdf, O, 2, PagesBody);
    AddObj(Pdf, O, 3, PageBody);
    AddObj(Pdf, O, 4, GoodSpec);
    AddObj(Pdf, O, 5, StreamBody(GoodStream, CheckXml));
    AddObj(Pdf, O, 6, '<< /Type /Filespec /F (z.xml) /UF (z.xml) /EF << /F 7 0 R >> /AFRelationship /Supplement >>');
    AddObj(Pdf, O, 7, StreamBody('/Type /EmbeddedFile /Subtype /text#2Fplain', 'z'));
    Finish(Pdf, O, 8, '');
    CheckOnly(R, Pdf, eps_Failed, 'BR-HYBRID-12', 'Names[2] Name tree of the embedded files: key not in ascending',
      'unsorted name tree');

    { other files and a second invoice }
    O := NoOffsets;
    Pdf := PdfHeader;
    AddObj(Pdf, O, 1, '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles << /Names [(factur-x.xml) 4 0 R ' +
      '(z.txt) 6 0 R] >> >> /AF [4 0 R] >>');
    AddObj(Pdf, O, 2, PagesBody);
    AddObj(Pdf, O, 3, PageBody);
    AddObj(Pdf, O, 4, GoodSpec);
    AddObj(Pdf, O, 5, StreamBody(GoodStream, CheckXml));
    AddObj(Pdf, O, 6, '<< /Type /Filespec /F (z.txt) /UF (z.txt) /EF << /F 7 0 R >> >>');
    AddObj(Pdf, O, 7, StreamBody('/Type /EmbeddedFile /Subtype /text#2Fplain', 'z'));
    Finish(Pdf, O, 8, '');
    RunCheck(Pdf, R);
    CheckEquals(1, Findings(R, 'LX-PDF-07', '"z.txt" has no /AFRelationship'), 'other file, relationship: ' +
      StatusText(R));
    CheckEquals(1, Findings(R, 'LX-PDF-07', '"z.txt" is not listed in /AF'), 'other file, /AF');
    CheckEquals(2, EmbeddingCount(R), 'nothing else: ' + StatusText(R));
    O := NoOffsets;
    Pdf := PdfHeader;
    AddObj(Pdf, O, 1, '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles << /Names [(a.xml) 6 0 R ' +
      '(factur-x.xml) 4 0 R] >> >> /AF [4 0 R 6 0 R] >>');
    AddObj(Pdf, O, 2, PagesBody);
    AddObj(Pdf, O, 3, PageBody);
    AddObj(Pdf, O, 4, GoodSpec);
    AddObj(Pdf, O, 5, StreamBody(GoodStream, CheckXml));
    AddObj(Pdf, O, 6, '<< /Type /Filespec /F (a.xml) /UF (a.xml) /EF << /F 5 0 R >> /AFRelationship /Data >>');
    Finish(Pdf, O, 7, '');
    CheckOnly(R, Pdf, eps_Failed, 'BR-HYBRID-12', 'A second invoice XML "a.xml" besides "factur-x.xml" ' +
      '(a second file specification of the same stream)', 'second invoice');
    CheckEqualsInvoiceStr('factur-x.xml', R.InvoiceFileName, 'the exact name wins');

    { no invoice }
    CheckOnly(R, SimplePdf('', GoodSpec, GoodStream, CheckXml), eps_Failed, 'BR-HYBRID-12',
      'no embedded files', 'no embedded files');
    CheckOnly(R, SimplePdf('/Names << /EmbeddedFiles << /Names [(a.txt) 4 0 R] >> >> /AF [4 0 R]',
      '<< /Type /Filespec /F (a.txt) /UF (a.txt) /EF << /F 5 0 R >> /AFRelationship /Data >>', GoodStream, 'text'),
      eps_Failed, 'BR-HYBRID-12', 'None of the 1 embedded files', 'no invoice');
    Check(R.HybridKind = ehk_None, 'no kind');
    CheckEquals(0, Integer(R.Invoice.Size), 'no bytes');

    { ZUGFeRD 2.0 and 1.0: recognised, not checked }
    CheckOnly(R, SimplePdf('/Names << /EmbeddedFiles << /Names [(zugferd-invoice.xml) 4 0 R] >> >>',
      '<< /F (zugferd-invoice.xml) /EF << /F 5 0 R >> >>', '', CheckXml),
      eps_Incomplete, 'LX-PDF-03', 'ZUGFeRD 2.0', 'ZUGFeRD 2.0');
    Check(R.HybridKind = ehk_ZUGFeRD20, 'kind 2.0');
    CheckEqualsBytes(CheckXml, StreamText(R.Invoice), 'extracted');
    CheckOnly(R, SimplePdf('/Names << /EmbeddedFiles << /Names [(ZUGFeRD-invoice.xml) 4 0 R] >> >>',
      '<< /F (ZUGFeRD-invoice.xml) /EF << /F 5 0 R >> >>', '', '<rsm:CrossIndustryDocument xmlns:rsm="urn:x"/>'),
      eps_Incomplete, 'LX-PDF-03', 'ZUGFeRD 1.0', 'ZUGFeRD 1.0');
    Check(R.HybridKind = ehk_ZUGFeRD10, 'kind 1.0');
    RunCheck(SimplePdf('/Names << /EmbeddedFiles << /Names [(zugferd-invoice.xml) 4 0 R] >> >>',
      '<< /F (zugferd-invoice.xml) /EF << /F 5 0 R >> >>', '/Filter /FlateDecode', CheckXml), R);
    Check(R.Status[epl_Embedding] = eps_Incomplete, 'damaged 2.0: ' + StatusText(R));
    CheckEquals(1, Findings(R, 'LX-PDF-03', 'cannot be extracted'), 'damaged 2.0 reported');
    CheckEquals(2, EmbeddingCount(R), 'info and warning: ' + StatusText(R));

    { more ways and values }
    CheckOnly(R, SimplePdf('/Names << /EmbeddedFiles << /Names [] >> >> /AF [4 0 R]', GoodSpec, GoodStream,
      CheckXml), eps_Failed, 'BR-HYBRID-12', 'not in the name tree', 'only in /AF');
    CheckOnly(R, SimplePdf(TreeAndAF, '<< /Type /F /F (factur-x.xml) /UF (factur-x.xml) /EF << /F 5 0 R >> ' +
      '/AFRelationship /Alternative >>', GoodStream, CheckXml), eps_Failed, 'BR-HYBRID-12', '/Type is /F, not',
      'wrong /Type');
    CheckOnly(R, SimplePdf(TreeAndAF, GoodSpec, '/Type /EmbeddedFile /Subtype /text#2Fxml /Params << /ModDate (D:2026) >>',
      #$FE#$FF#0'<'#0'a'#0'/'#0'>'), eps_Passed, 'LX-PDF-06', 'UTF-16', 'UTF-16');
    O := NoOffsets;
    Pdf := PdfHeader;
    AddObj(Pdf, O, 1, '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles << /Names [(factur-x.xml) 4 0 R ' +
      '(z.txt) 6 0 R] >> >> /AF [4 0 R] >>');
    AddObj(Pdf, O, 2, PagesBody);
    AddObj(Pdf, O, 3, '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /AF [6 0 R] >>');
    AddObj(Pdf, O, 4, GoodSpec);
    AddObj(Pdf, O, 5, StreamBody(GoodStream, CheckXml));
    AddObj(Pdf, O, 6, '<< /Type /Filespec /F (z.txt) /UF (z.txt) /EF << /F 7 0 R >> /AFRelationship /Supplement >>');
    AddObj(Pdf, O, 7, StreamBody('/Type /EmbeddedFile /Subtype /text#2Fplain', 'z'));
    Finish(Pdf, O, 8, '');
    RunCheck(Pdf, R);
    CheckEquals(0, EmbeddingErrors(R), 'a file associated with a page: ' + StatusText(R));
    CheckEquals(0, EmbeddingCount(R), 'no findings: ' + StatusText(R));
    { a name tree deeper than the object layer reads }
    O := NoOffsets;
    Pdf := PdfHeader;
    AddObj(Pdf, O, 1, '<< /Type /Catalog /Pages 2 0 R /Names << /EmbeddedFiles 6 0 R >> /AF [4 0 R] >>');
    AddObj(Pdf, O, 2, PagesBody);
    AddObj(Pdf, O, 3, PageBody);
    AddObj(Pdf, O, 4, GoodSpec);
    AddObj(Pdf, O, 5, StreamBody(GoodStream, CheckXml));
    for I := 6 to 75 do
      AddObj(Pdf, O, I, '<< /Kids [' + IntToAnsi(I + 1) + ' 0 R] /Limits [(factur-x.xml) (factur-x.xml)] >>');
    AddObj(Pdf, O, 76, '<< /Names [(factur-x.xml) 4 0 R] /Limits [(factur-x.xml) (factur-x.xml)] >>');
    Finish(Pdf, O, 77, '');
    RunCheck(Pdf, R);
    CheckEquals(1, Findings(R, 'LX-PDF-08', 'too deep a name tree'), 'limit: ' + StatusText(R));
    Check(R.Status[epl_Embedding] <> eps_Passed, 'a limit never passes');

    { the PDF itself }
    CheckOnly(R, 'no PDF', eps_Failed, 'LX-PDF-01', 'not readable', 'not a PDF');
    Pdf := SimplePdf(TreeAndAF, GoodSpec, GoodStream, CheckXml);
    Pdf := Copy(Pdf, 1, RawPos('startxref', Pdf) + 9) + '99999'#10'%%EOF'#10;
    CheckOnly(R, Pdf, eps_Incomplete, 'LX-PDF-02', 'scan', 'reconstructed');
    CheckEquals(Length(CheckXml), Integer(R.Invoice.Size), 'still extracted');
  finally
    R.Free;
  end;
end;

function Facts(AStandard: TLandrixEInvoiceStandard; ASyntax: TLandrixEInvoiceSyntax;
  AProfile: TLandrixEInvoiceProfile; const ASeller, ABuyer: string): TLandrixEInvoicePdfInvoiceFacts;
begin
  Result.Target.Standard := AStandard;
  Result.Target.Syntax := ASyntax;
  Result.Target.Profile := AProfile;
  Result.Target.Version := '';
  Result.SellerCountryCode := TLandrixEInvoiceString(ASeller);
  Result.BuyerCountryCode := TLandrixEInvoiceString(ABuyer);
end;

function FacturXFacts(AProfile: TLandrixEInvoiceProfile; const ASeller, ABuyer: string): TLandrixEInvoicePdfInvoiceFacts;
begin
  Result := Facts(est_FacturX, esy_CII, AProfile, ASeller, ABuyer);
end;

{ Runs both passes; checks status, number of findings and the finding of
  ARule with AText ('' rule: no finding expected). }
procedure CheckFactsCase(AResult: TLandrixEInvoicePdfCheckResult; const APdf: AnsiString;
  const AFacts: TLandrixEInvoicePdfInvoiceFacts; AStatus: TLandrixEInvoicePdfLevelStatus; ACount: Integer;
  const ARule, AText, Msg: string);
var
  Checker: TLandrixEInvoicePdfChecker;
  Errors: Integer;
begin
  RunCheck(APdf, AResult);
  Checker := TLandrixEInvoicePdfChecker.Create;
  try
    Errors := Checker.CheckInvoiceFacts(AResult, AFacts);
  finally
    Checker.Free;
  end;
  Check(AResult.Status[epl_Embedding] = AStatus, Msg + ': status ' + StatusText(AResult));
  CheckEquals(ACount, EmbeddingCount(AResult), Msg + ': findings: ' + StatusText(AResult));
  if ARule <> '' then
    CheckEquals(1, Findings(AResult, ARule, AText), Msg + ': ' + ARule + ' ' + AText);
  if AStatus = eps_Failed then
    Check(Errors > 0, Msg + ': errors')
  else
    CheckEquals(0, Errors, Msg + ': errors');
end;

function NamedPdf(const AName, ARelationship: AnsiString): AnsiString;
begin
  Result := SimplePdf('/Names << /EmbeddedFiles << /Names [(' + AName + ') 4 0 R] >> >> /AF [4 0 R]',
    '<< /Type /Filespec /F (' + AName + ') /UF (' + AName + ') /EF << /F 5 0 R >> /AFRelationship /' +
    ARelationship + ' >>', GoodStream, CheckXml);
end;

procedure TestCheckFacts;
var
  R: TLandrixEInvoicePdfCheckResult;
  Checker: TLandrixEInvoicePdfChecker;
  Good: AnsiString;
begin
  Good := NamedPdf('factur-x.xml', 'Alternative');
  R := TLandrixEInvoicePdfCheckResult.Create;
  Checker := TLandrixEInvoicePdfChecker.Create;
  try
    { the reference case and the facts kept in the result }
    CheckFactsCase(R, Good, FacturXFacts(epr_EN16931, 'DE', 'DE'), eps_Passed, 0, '', '', 'EN 16931 in DE');
    Check(R.FactsChecked and (R.Profile = epr_EN16931), 'facts checked, profile derived');
    CheckEqualsInvoiceStr('DE', R.InvoiceFacts.SellerCountryCode, 'facts kept');
    CheckEqualsInvoiceStr('/Root/Names/EmbeddedFiles/Names[1]', R.InvoicePath, 'path of the invoice');
    CheckEqualsInvoiceStr('factur-x.xml', R.InvoiceFileNameF, '/F kept');
    { a second call adds nothing }
    CheckEquals(0, Checker.CheckInvoiceFacts(R, FacturXFacts(epr_Minimum, 'DE', 'DE')), 'second call');
    CheckEquals(0, EmbeddingCount(R), 'second call without findings');
    Check(R.Profile = epr_EN16931, 'second call keeps the profile');

    { BR-HYBRID-11 per profile and country }
    CheckFactsCase(R, NamedPdf('factur-x.xml', 'Data'), FacturXFacts(epr_EN16931, 'DE', 'DE'), eps_Passed, 1,
      'BR-HYBRID-11', 'asks for /Alternative for the profile EN 16931 with seller and buyer in DE', 'Data in DE');
    CheckFactsCase(R, NamedPdf('factur-x.xml', 'Data'), FacturXFacts(epr_EN16931, 'FR', 'FR'), eps_Passed, 0, '', '',
      'Data in FR');
    CheckFactsCase(R, NamedPdf('factur-x.xml', 'Data'), FacturXFacts(epr_EN16931, 'DE', 'FR'), eps_Passed, 0, '', '',
      'Data across borders');
    CheckFactsCase(R, Good, FacturXFacts(epr_BasicWL, 'DE', 'FR'), eps_Passed, 1, 'BR-HYBRID-11',
      'asks for /Data for the profile BASIC WL', 'BASIC WL across borders');
    CheckFactsCase(R, NamedPdf('factur-x.xml', 'Unspecified'), FacturXFacts(epr_Minimum, 'FR', 'FR'), eps_Passed, 1,
      'BR-HYBRID-11', '/Unspecified', 'a value outside the table is reported once');

    { BR-HYBRID-DE-01/02, BR-HYBRID-FR-01 }
    CheckFactsCase(R, NamedPdf('factur-x.xml', 'Data'), FacturXFacts(epr_Minimum, 'DE', 'DE'), eps_Failed, 1,
      'BR-HYBRID-DE-01', 'MINIMUM', 'MINIMUM in DE');
    CheckFactsCase(R, NamedPdf('factur-x.xml', 'Data'), FacturXFacts(epr_BasicWL, 'DE', 'DE'), eps_Failed, 1,
      'BR-HYBRID-DE-02', 'BASIC WL', 'BASIC WL in DE');
    CheckFactsCase(R, NamedPdf('factur-x.xml', 'Data'), FacturXFacts(epr_BasicWL, 'DE', ''), eps_Passed, 0, '', '',
      'BASIC WL, buyer country unknown');
    CheckFactsCase(R, NamedPdf('xrechnung.xml', 'Alternative'), Facts(est_XRechnung, esy_CII, epr_None, 'FR', 'FR'),
      eps_Failed, 1, 'BR-HYBRID-FR-01', 'XRECHNUNG', 'XRECHNUNG in FR');
    Check(R.Profile = epr_XRechnung, 'XRechnung CII is the profile XRECHNUNG');
    CheckFactsCase(R, NamedPdf('xrechnung.xml', 'Data'), Facts(est_XRechnung, esy_CII, epr_None, 'FR', 'FR'),
      eps_Failed, 1, 'BR-HYBRID-FR-01', 'XRECHNUNG', 'XRECHNUNG in FR: no BR-HYBRID-11 (not applicable)');
    CheckFactsCase(R, NamedPdf('xrechnung.xml', 'Data'), Facts(est_XRechnung, esy_CII, epr_None, 'DE', 'FR'),
      eps_Passed, 1, 'BR-HYBRID-11', 'asks for /Alternative for the profile XRECHNUNG', 'XRECHNUNG across borders');
    CheckFactsCase(R, NamedPdf('factur-x.xml', 'Data'), FacturXFacts(epr_None, 'DE', 'DE'), eps_Passed, 0, '', '',
      'Factur-X without profile');

    { BR-HYBRID-13: file name and profile }
    CheckFactsCase(R, NamedPdf('xrechnung.xml', 'Alternative'), Facts(est_XRechnung, esy_CII, epr_None, 'DE', 'DE'),
      eps_Passed, 0, '', '', 'XRECHNUNG as xrechnung.xml');
    CheckFactsCase(R, Good, Facts(est_XRechnung, esy_CII, epr_None, 'DE', 'DE'), eps_Failed, 2, 'BR-HYBRID-13',
      'Names[1]/UF An invoice of the profile XRECHNUNG is named xrechnung.xml', 'XRECHNUNG as factur-x.xml');
    CheckFactsCase(R, NamedPdf('xrechnung.xml', 'Alternative'), FacturXFacts(epr_Extended, 'DE', 'DE'), eps_Failed, 2,
      'BR-HYBRID-13', 'Names[1]/F The file name xrechnung.xml needs the profile XRECHNUNG; the invoice has the ' +
      'profile EXTENDED', 'EXTENDED as xrechnung.xml');

    { no ZUGFeRD profile }
    CheckFactsCase(R, Good, Facts(est_PeppolBIS, esy_UBL, epr_None, 'DE', 'DE'), eps_Failed, 1, 'LX-PDF-10',
      'Names[1] The embedded invoice is UBL', 'Peppol UBL');
    CheckFactsCase(R, NamedPdf('factur-x.xml', 'Data'), Facts(est_None, esy_None, epr_None, 'DE', 'DE'), eps_Passed,
      0, '', '', 'unknown profile: the general table only');

    { an incomplete first pass stays incomplete with a warning and fails with an error }
    Good := SimplePdf(TreeAndAF, GoodSpec, GoodStream, CheckXml);
    Good := Copy(Good, 1, RawPos('startxref', Good) + 9) + '99999'#10'%%EOF'#10;
    CheckFactsCase(R, Good, FacturXFacts(epr_BasicWL, 'FR', 'FR'), eps_Incomplete, 2, 'BR-HYBRID-11',
      'asks for /Data', 'incomplete and a warning');
    CheckFactsCase(R, Good, FacturXFacts(epr_Minimum, 'DE', 'DE'), eps_Failed, 3, 'BR-HYBRID-DE-01', 'MINIMUM',
      'incomplete and an error');

    { nothing to do }
    RunCheck(SimplePdf('/Names << /EmbeddedFiles << /Names [(zugferd-invoice.xml) 4 0 R] >> >>',
      '<< /F (zugferd-invoice.xml) /EF << /F 5 0 R >> >>', '', CheckXml), R);
    CheckEquals(0, Checker.CheckInvoiceFacts(R, FacturXFacts(epr_Minimum, 'DE', 'DE')), 'ZUGFeRD 2.0');
    Check(not R.FactsChecked and (R.Status[epl_Embedding] = eps_Incomplete), 'ZUGFeRD 2.0 untouched');
    R.Clear;
    CheckEquals(0, Checker.CheckInvoiceFacts(R, FacturXFacts(epr_Minimum, 'DE', 'DE')), 'not checked yet');
    Check(not R.FactsChecked and (R.Status[epl_Embedding] = eps_NotRun), 'cleared result untouched');
    CheckEquals(0, Checker.CheckInvoiceFacts(nil, FacturXFacts(epr_Minimum, 'DE', 'DE')), 'no result');
  finally
    Checker.Free;
    R.Free;
  end;
end;

function MetadataStatusText(AResult: TLandrixEInvoicePdfCheckResult): string;
const
  Names: array[TLandrixEInvoicePdfLevelStatus] of string = ('not run', 'passed', 'failed', 'incomplete');
begin
  Result := Names[AResult.Status[epl_Metadata]] + ': ' + string(AResult.Diagnostics.ToText);
end;

{ The reference PDF with the XMP packet AXmp; checks the level 3 status,
  the number of level 3 findings and the finding of ARule with AText. }
procedure CheckXmp(AResult: TLandrixEInvoicePdfCheckResult; const AXmp: AnsiString;
  AStatus: TLandrixEInvoicePdfLevelStatus; ACount: Integer; const ARule, AText, Msg: string);
begin
  RunCheck(SimplePdfX(TreeAndAF, GoodSpec, GoodStream, CheckXml, AXmp), AResult);
  Check(AResult.Status[epl_Embedding] = eps_Passed, Msg + ': level 2 ' + StatusText(AResult));
  Check(AResult.Status[epl_Metadata] = AStatus, Msg + ': status ' + MetadataStatusText(AResult));
  CheckEquals(ACount, MetadataCount(AResult), Msg + ': findings: ' + MetadataStatusText(AResult));
  if ARule <> '' then
    CheckEquals(1, Findings(AResult, ARule, AText), Msg + ': ' + ARule + ' ' + AText);
end;

procedure TestCheckMetadata;
var
  R: TLandrixEInvoicePdfCheckResult;
  Checker: TLandrixEInvoicePdfChecker;
  Good, XR, Pdf: AnsiString;
  I: Integer;
begin
  Good := GoodXmp;
  XR := XmpPacket(TLandrixEInvoiceTargets.XRechnung('3.0', esy_CII));
  R := TLandrixEInvoicePdfCheckResult.Create;
  Checker := TLandrixEInvoicePdfChecker.Create;
  try
    { the reference case: what the writer side writes passes }
    CheckEquals(0, RunCheck(SimplePdf(TreeAndAF, GoodSpec, GoodStream, CheckXml), R), 'no errors');
    Check(R.Status[epl_Metadata] = eps_Passed, 'passed: ' + MetadataStatusText(R));
    CheckEquals(0, Integer(R.Diagnostics.Count), 'no findings: ' + MetadataStatusText(R));
    CheckEqualsInvoiceStr('INVOICE', R.XmpDocumentType, 'document type');
    CheckEqualsInvoiceStr('factur-x.xml', R.XmpDocumentFileName, 'file name');
    CheckEqualsInvoiceStr('1.0', R.XmpVersion, 'version');
    CheckEqualsInvoiceStr('EN 16931', R.XmpConformanceLevel, 'conformance level');
    CheckEqualsInvoiceStr('3', R.PdfAPart, 'PDF/A part');
    CheckEqualsInvoiceStr('B', R.PdfAConformance, 'PDF/A conformance');
    Check(R.Status[epl_PdfA] = eps_NotRun, 'level 1 not run');
    { the attribute form says the same }
    CheckXmp(R, RawReplace(RawReplace(Good, '<pdfaid:part>3</pdfaid:part><pdfaid:conformance>B</pdfaid:conformance>' +
      '</rdf:Description>', '</rdf:Description>'), 'xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/" rdf:about="">',
      'xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/" rdf:about="" pdfaid:part="3" pdfaid:conformance="U">'),
      eps_Passed, 0, '', '', 'pdfaid as attributes');
    CheckEqualsInvoiceStr('U', R.PdfAConformance, 'conformance from the attribute');
    { an extension schema item as rdf:Description instead of rdf:parseType }
    CheckXmp(R, RawReplace(RawReplace(Good, '<rdf:Bag>'#10'<rdf:li rdf:parseType="Resource">',
      '<rdf:Bag>'#10'<rdf:li><rdf:Description>'), '</pdfaSchema:property>'#10'</rdf:li>',
      '</pdfaSchema:property>'#10'</rdf:Description></rdf:li>'), eps_Passed, 0, '', '', 'rdf:Description in rdf:li');

    { LX-PDF-11: no readable XMP }
    CheckXmp(R, '', eps_Failed, 1, 'LX-PDF-11', 'no XMP metadata', 'no /Metadata');
    CheckXmp(R, '<x:xmpmeta xmlns:x="adobe:ns:meta/">', eps_Failed, 1, 'LX-PDF-11', 'not well-formed', 'damaged XMP');
    CheckXmp(R, '<x:xmpmeta xmlns:x="adobe:ns:meta/"/>', eps_Failed, 1, 'LX-PDF-11', 'no rdf:RDF', 'empty XMP');
    CheckEqualsInvoiceStr('', R.XmpConformanceLevel, 'no values');

    { BR-HYBRID-02: the claimed PDF/A part }
    CheckXmp(R, RawReplace(Good, '<pdfaid:part>3<', '<pdfaid:part>2<'), eps_Failed, 1, 'BR-HYBRID-02',
      'XMP pdfaid:part The XMP metadata claims PDF/A part 2', 'PDF/A-2');
    CheckXmp(R, RawReplace(Good, '<pdfaid:conformance>B<', '<pdfaid:conformance>X<'), eps_Failed, 1, 'BR-HYBRID-02',
      'conformance level "X"', 'PDF/A-3X');
    CheckXmp(R, RawReplace(RawReplace(Good, '<pdfaid:part>3<', '<pdfaid:part>4<'), '<pdfaid:conformance>B<',
      '<pdfaid:conformance>F<'), eps_Passed, 0, '', '', 'PDF/A-4f');
    CheckXmp(R, RawReplace(Good, '<pdfaid:part>3</pdfaid:part>', ''), eps_Failed, 1, 'BR-HYBRID-02',
      'claims no PDF/A part', 'no part');

    { BR-HYBRID-03 to -05: the extension schema }
    CheckXmp(R, RawReplace(RawReplace(Good, 'pdfaExtension:schemas>', 'pdfaExtension:schemaz>'), 'pdfaExtension:schemas>',
      'pdfaExtension:schemaz>'), eps_Failed, 1,
      'BR-HYBRID-03', 'no PDF/A extension schema', 'no extension schema');
    CheckXmp(R, RawReplace(Good, '<pdfaSchema:namespaceURI>urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#<',
      '<pdfaSchema:namespaceURI>urn:factur-x:pdfa:crossindustrydocument:invoice:1p0#<'), eps_Failed, 1,
      'BR-HYBRID-04', 'declares the namespace urn:factur-x:pdfa:crossindustrydocument', 'schema namespace case');
    CheckXmp(R, RawReplace(Good, '<pdfaSchema:namespaceURI>urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#<',
      '<pdfaSchema:namespaceURI>urn:other#<'), eps_Failed, 1, 'BR-HYBRID-03', 'does not declare the namespace',
      'other schema only');
    CheckXmp(R, RawReplace(Good, '<pdfaSchema:prefix>fx<', '<pdfaSchema:prefix>zf<'), eps_Failed, 1, 'BR-HYBRID-05',
      'declares the prefix "zf"', 'schema prefix');
    CheckXmp(R, RawReplace(Good, '<pdfaProperty:name>Version<', '<pdfaProperty:name>Versio<'), eps_Failed, 1,
      'BR-HYBRID-03', 'declares no property Version', 'property missing');
    CheckXmp(R, RawReplace(Good, 'ConformanceLevel</pdfaProperty:name>'#10'<pdfaProperty:valueType>Text<',
      'ConformanceLevel</pdfaProperty:name>'#10'<pdfaProperty:valueType>Integer<'), eps_Failed, 1, 'BR-HYBRID-03',
      'ConformanceLevel has the value type "Integer"', 'value type');
    CheckXmp(R, RawReplace(Good, 'DocumentType</pdfaProperty:name>'#10'<pdfaProperty:valueType>Text</pdfaProperty:valueType>'#10 +
      '<pdfaProperty:category>external<', 'DocumentType</pdfaProperty:name>'#10'<pdfaProperty:valueType>Text' +
      '</pdfaProperty:valueType>'#10'<pdfaProperty:category>internal<'), eps_Failed, 1, 'BR-HYBRID-03',
      'DocumentType has the category "internal"', 'category');
    CheckXmp(R, RawReplace(Good, '<pdfaProperty:description>INVOICE</pdfaProperty:description>', ''), eps_Failed, 1,
      'BR-HYBRID-03', 'DocumentType has no description', 'description');

    { BR-HYBRID-04/-05: the properties }
    CheckXmp(R, RawReplace(Good, 'xmlns:fx="urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#"',
      'xmlns:fx="urn:factur-x:pdfa:crossindustrydocument:invoice:1p0#"'), eps_Failed, 1, 'BR-HYBRID-04',
      'use the namespace urn:factur-x:pdfa:crossindustrydocument:invoice:1p0#', 'property namespace');
    CheckEqualsInvoiceStr('EN 16931', R.XmpConformanceLevel, 'read in the other namespace');
    CheckXmp(R, RawReplace(Good, 'xmlns:fx="urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#"',
      'xmlns:fx="urn:other#"'), eps_Failed, 1, 'BR-HYBRID-04', 'use the namespace urn:other#', 'another URI');
    CheckXmp(R, RawReplace(Good, '<fx:ConformanceLevel>EN 16931</fx:ConformanceLevel>', ''), eps_Failed, 1, 'BR-HYBRID-07',
      'fx:ConformanceLevel is missing', 'ConformanceLevel missing');
    Pdf := Good;
    Pdf := RawReplace(Pdf, 'xmlns:fx=', 'xmlns:f=');
    while RawPos('fx:Document', Pdf) > 0 do
      Pdf := RawReplace(Pdf, 'fx:Document', 'f:Document');
    while RawPos('fx:Version', Pdf) > 0 do
      Pdf := RawReplace(Pdf, 'fx:Version', 'f:Version');
    while RawPos('fx:ConformanceLevel', Pdf) > 0 do
      Pdf := RawReplace(Pdf, 'fx:ConformanceLevel', 'f:ConformanceLevel');
    CheckXmp(R, Pdf, eps_Failed, 1, 'BR-HYBRID-05', 'use the prefix "f"', 'property prefix');

    { BR-HYBRID-06 to -10: the code lists }
    CheckXmp(R, RawReplace(Good, '>INVOICE</fx:', '>ORDER</fx:'), eps_Failed, 1, 'BR-HYBRID-06', 'Order-X',
      'ORDER');
    CheckXmp(R, RawReplace(Good, '>INVOICE</fx:', '>Invoice</fx:'), eps_Failed, 1, 'BR-HYBRID-06',
      '"Invoice" is not in the code list', 'Invoice');
    CheckXmp(R, RawReplace(Good, '>EN 16931<', '>EN16931<'), eps_Failed, 1, 'BR-HYBRID-07',
      '"EN16931" is not in the code list', 'EN16931 without a blank');
    CheckXmp(R, RawReplace(Good, '>EN 16931<', '>COMFORT<'), eps_Failed, 1, 'BR-HYBRID-07', 'Order-X', 'COMFORT');
    CheckXmp(R, RawReplace(Good, '<fx:DocumentFileName>factur-x.xml<', '<fx:DocumentFileName>invoice.xml<'),
      eps_Failed, 2, 'BR-HYBRID-08', '"invoice.xml" is not in the code list', 'invoice.xml');
    CheckEquals(1, Findings(R, 'BR-HYBRID-14', 'is invoice.xml; the embedded invoice is named factur-x.xml'),
      'and a different name');
    CheckXmp(R, RawReplace(Good, '<fx:DocumentFileName>factur-x.xml<', '<fx:DocumentFileName>xrechnung.xml<'),
      eps_Failed, 2, 'BR-HYBRID-08', 'xrechnung.xml needs fx:ConformanceLevel XRECHNUNG, not EN 16931',
      'xrechnung.xml with EN 16931');
    CheckXmp(R, RawReplace(Good, '>EN 16931<', '>XRECHNUNG<'), eps_Failed, 1, 'BR-HYBRID-08',
      'XRECHNUNG needs fx:DocumentFileName xrechnung.xml', 'XRECHNUNG as factur-x.xml');
    CheckXmp(R, RawReplace(Good, '<fx:Version>1.0<', '<fx:Version>2p1<'), eps_Passed, 1, 'BR-HYBRID-10',
      'fx:Version is 2p1', 'legacy version');
    CheckXmp(R, RawReplace(Good, '<fx:Version>1.0<', '<fx:Version>3.0<'), eps_Failed, 1, 'BR-HYBRID-09',
      '"3.0" is not in the code list', 'version 3.0 for EN 16931');
    CheckXmp(R, RawReplace(Good, '<fx:Version>1.0</fx:Version>', '<fx:Version></fx:Version>'), eps_Failed, 1,
      'BR-HYBRID-09', 'fx:Version is missing', 'empty version');

    { XRECHNUNG: a version like 3.0 is accepted }
    Pdf := SimplePdfX('/Names << /EmbeddedFiles << /Names [(xrechnung.xml) 4 0 R] >> >> /AF [4 0 R]',
      '<< /Type /Filespec /F (xrechnung.xml) /UF (xrechnung.xml) /EF << /F 5 0 R >> /AFRelationship /Alternative >>',
      GoodStream, CheckXml, RawReplace(XR, '<fx:Version>1.0<', '<fx:Version>3.0<'));
    RunCheck(Pdf, R);
    Check(R.Status[epl_Metadata] = eps_Passed, 'XRECHNUNG 3.0: ' + MetadataStatusText(R));
    CheckEquals(1, MetadataCount(R), 'XRECHNUNG 3.0: ' + MetadataStatusText(R));
    CheckEquals(1, Findings(R, 'BR-HYBRID-10', 'fx:Version is 3.0'), 'XRECHNUNG 3.0 warns');
    CheckEqualsInvoiceStr('xrechnung.xml', R.XmpDocumentFileName, 'XRechnung file name');

    { BR-HYBRID-14: the embedded name differs }
    RunCheck(SimplePdfX('/Names << /EmbeddedFiles << /Names [(xrechnung.xml) 4 0 R] >> >> /AF [4 0 R]',
      '<< /Type /Filespec /F (xrechnung.xml) /UF (xrechnung.xml) /EF << /F 5 0 R >> /AFRelationship /Alternative >>',
      GoodStream, CheckXml, Good), R);
    Check(R.Status[epl_Metadata] = eps_Passed, 'BR-HYBRID-14 is a warning: ' + MetadataStatusText(R));
    CheckEquals(1, MetadataCount(R), 'one finding: ' + MetadataStatusText(R));
    CheckEquals(1, Findings(R, 'BR-HYBRID-14', 'fx:DocumentFileName is factur-x.xml; the embedded invoice is ' +
      'named xrechnung.xml'), 'BR-HYBRID-14');

    { BR-HYBRID-15 in the second pass }
    RunCheck(SimplePdf(TreeAndAF, GoodSpec, GoodStream, CheckXml), R);
    CheckEquals(0, Checker.CheckInvoiceFacts(R, FacturXFacts(epr_Extended, 'DE', 'DE')), 'BR-HYBRID-15 no error');
    CheckEquals(1, Findings(R, 'BR-HYBRID-15', 'XMP fx:ConformanceLevel fx:ConformanceLevel is EN 16931; the ' +
      'invoice has the profile EXTENDED'), 'BR-HYBRID-15: ' + MetadataStatusText(R));
    CheckEquals(1, Integer(R.Diagnostics.Count), 'nothing else: ' + MetadataStatusText(R));
    Check(R.Status[epl_Metadata] = eps_Passed, 'a warning');
    RunCheck(SimplePdf(TreeAndAF, GoodSpec, GoodStream, CheckXml), R);
    CheckEquals(0, Checker.CheckInvoiceFacts(R, FacturXFacts(epr_EN16931, 'DE', 'DE')), 'same profile');
    CheckEquals(0, Integer(R.Diagnostics.Count), 'same profile: ' + MetadataStatusText(R));
    RunCheck(SimplePdfX(TreeAndAF, GoodSpec, GoodStream, CheckXml, RawReplace(Good, '>EN 16931<', '>EN16931<')), R);
    Checker.CheckInvoiceFacts(R, FacturXFacts(epr_Extended, 'DE', 'DE'));
    CheckEquals(0, Findings(R, 'BR-HYBRID-15', 'fx:ConformanceLevel'), 'a value outside the code list has its error already');

    { RDF variants: rdf:resource, the attribute form of the fx properties }
    CheckXmp(R, RawReplace(Good, '<pdfaSchema:namespaceURI>urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#' +
      '</pdfaSchema:namespaceURI>', '<pdfaSchema:namespaceURI rdf:resource="urn:factur-x:pdfa:CrossIndustryDocument:' +
      'invoice:1p0#"/>'), eps_Passed, 0, '', '', 'rdf:resource');
    CheckXmp(R, RawReplace(Good, '<rdf:Description xmlns:fx="urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#" ' +
      'rdf:about="">'#10'<fx:DocumentType>INVOICE</fx:DocumentType>'#10'<fx:DocumentFileName>factur-x.xml' +
      '</fx:DocumentFileName>'#10'<fx:Version>1.0</fx:Version>'#10'<fx:ConformanceLevel>EN 16931' +
      '</fx:ConformanceLevel></rdf:Description>', '<rdf:Description xmlns:fx="urn:factur-x:pdfa:CrossIndustryDocument:' +
      'invoice:1p0#" rdf:about="" fx:DocumentType="INVOICE" fx:DocumentFileName="factur-x.xml" fx:Version="1.0" ' +
      'fx:ConformanceLevel="BASIC"/>'), eps_Passed, 0, '', '', 'fx as attributes');
    CheckEqualsInvoiceStr('BASIC', R.XmpConformanceLevel, 'conformance level from the attribute');

    { one value per property }
    CheckXmp(R, RawReplace(Good, '<fx:DocumentType>INVOICE</fx:DocumentType>', '<fx:DocumentType>INVOICE' +
      '</fx:DocumentType><fx:DocumentType>ORDER</fx:DocumentType>'), eps_Failed, 1, 'BR-HYBRID-06',
      'fx:DocumentType occurs 2 times', 'a second fx:DocumentType');
    CheckXmp(R, RawReplace(Good, 'xmlns:fx="urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#" rdf:about=""',
      'xmlns:fx="urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#" rdf:about="" fx:Version="1.0"'), eps_Failed, 1,
      'BR-HYBRID-09', 'fx:Version occurs 2 times', 'attribute and element');
    CheckXmp(R, RawReplace(Good, '<pdfaid:part>3</pdfaid:part>', '<pdfaid:part>3</pdfaid:part><pdfaid:part>2' +
      '</pdfaid:part>'), eps_Failed, 1, 'BR-HYBRID-02', 'pdfaid:part occurs 2 times', 'a second pdfaid:part');

    { the extension schema: its name and the containers }
    CheckXmp(R, RawReplace(Good, '<pdfaSchema:schema>Factur-X PDFA Extension Schema</pdfaSchema:schema>', ''),
      eps_Failed, 1, 'BR-HYBRID-03', 'has no name', 'no schema name');
    CheckXmp(R, RawReplace(RawReplace(Good, '<rdf:Bag>', '<rdf:Alt>'), '</rdf:Bag>', '</rdf:Alt>'), eps_Failed, 2,
      'BR-HYBRID-03', 'pdfaExtension:schemas is an rdf:Alt; expected rdf:Bag', 'schemas not in a Bag');
    CheckXmp(R, RawReplace(RawReplace(Good, '<rdf:Seq>', '<rdf:Bag>'), '</rdf:Seq>', '</rdf:Bag>'), eps_Failed, 5,
      'BR-HYBRID-03', 'pdfaSchema:property is an rdf:Bag; expected rdf:Seq', 'properties not in a Seq');

    CheckXmp(R, RawReplace(Good, '<pdfaProperty:name>Version</pdfaProperty:name>'#10'<pdfaProperty:valueType>Text' +
      '</pdfaProperty:valueType>', '<pdfaProperty:name>Version</pdfaProperty:name>'#10'<pdfaProperty:valueType>Text' +
      '</pdfaProperty:valueType><pdfaProperty:valueType>Integer</pdfaProperty:valueType>'), eps_Failed, 1,
      'BR-HYBRID-03', 'pdfaProperty:valueType occurs 2 times', 'a second value type');
    CheckXmp(R, RawReplace(Good, '</rdf:Bag>', '</rdf:Bag><rdf:Alt/>'), eps_Failed, 2, 'BR-HYBRID-03',
      'pdfaExtension:schemas has 2 elements; expected one rdf:Bag', 'a second container');

    { limits: a finding, never passed }
    Pdf := '';
    for I := 1 to 20001 do
      Pdf := Pdf + '<a/>';
    CheckXmp(R, '<x:xmpmeta xmlns:x="adobe:ns:meta/">' + Pdf + '</x:xmpmeta>', eps_Incomplete, 1, 'LX-PDF-08',
      'too large', 'too many elements');
    Pdf := '';
    for I := 1 to 20001 do
      Pdf := Pdf + 'a<!---->';
    CheckXmp(R, '<x:xmpmeta xmlns:x="adobe:ns:meta/">' + Pdf + '</x:xmpmeta>', eps_Incomplete, 1, 'LX-PDF-08',
      'too large', 'too many text pieces');
    Pdf := '';
    for I := 1 to 70 do
      Pdf := '<a>' + Pdf + '</a>';
    CheckXmp(R, Pdf, eps_Incomplete, 1, 'LX-PDF-08', 'too deep', 'too deep');
    { a value cut at the limit cannot pass }
    Pdf := '1.';
    for I := 1 to 4094 do
      Pdf := Pdf + '0';
    Pdf := SimplePdfX('/Names << /EmbeddedFiles << /Names [(xrechnung.xml) 4 0 R] >> >> /AF [4 0 R]',
      '<< /Type /Filespec /F (xrechnung.xml) /UF (xrechnung.xml) /EF << /F 5 0 R >> /AFRelationship /Alternative >>',
      GoodStream, CheckXml, RawReplace(XR, '<fx:Version>1.0<', '<fx:Version>' + Pdf + 'X<'));
    RunCheck(Pdf, R);
    CheckEquals(1, Findings(R, 'BR-HYBRID-09', 'is not in the code list'), 'cut version: ' + MetadataStatusText(R));
    { the same with the rest in a second text piece right at the limit }
    Pdf := '1.';
    for I := 1 to 4094 do
      Pdf := Pdf + '0';
    Pdf := SimplePdfX('/Names << /EmbeddedFiles << /Names [(xrechnung.xml) 4 0 R] >> >> /AF [4 0 R]',
      '<< /Type /Filespec /F (xrechnung.xml) /UF (xrechnung.xml) /EF << /F 5 0 R >> /AFRelationship /Alternative >>',
      GoodStream, CheckXml, RawReplace(XR, '<fx:Version>1.0<', '<fx:Version>' + Pdf + '<![CDATA[X]]><'));
    RunCheck(Pdf, R);
    CheckEquals(1, Findings(R, 'BR-HYBRID-09', 'is not in the code list'), 'cut at a piece boundary: ' +
      MetadataStatusText(R));

    { BR-HYBRID-15 for XRECHNUNG }
    RunCheck(SimplePdfX('/Names << /EmbeddedFiles << /Names [(xrechnung.xml) 4 0 R] >> >> /AF [4 0 R]',
      '<< /Type /Filespec /F (xrechnung.xml) /UF (xrechnung.xml) /EF << /F 5 0 R >> /AFRelationship /Alternative >>',
      GoodStream, CheckXml, XR), R);
    CheckEquals(0, Checker.CheckInvoiceFacts(R, Facts(est_XRechnung, esy_CII, epr_None, 'DE', 'DE')), 'XRECHNUNG');
    CheckEquals(0, Integer(R.Diagnostics.Count), 'XRECHNUNG matches: ' + MetadataStatusText(R));

    { levels have their own status }
    RunCheck(SimplePdf('/AF [4 0 R]', GoodSpec, GoodStream, CheckXml), R);
    Check((R.Status[epl_Embedding] = eps_Failed) and (R.Status[epl_Metadata] = eps_Passed),
      'level 2 fails, level 3 passes: ' + MetadataStatusText(R));
    CheckXmp(R, RawReplace(Good, '>INVOICE</fx:', '>ORDER</fx:'), eps_Failed, 1, 'BR-HYBRID-06', 'Order-X',
      'level 3 fails, level 2 passes');
    Pdf := SimplePdf(TreeAndAF, GoodSpec, GoodStream, CheckXml);
    Pdf := Copy(Pdf, 1, RawPos('startxref', Pdf) + 9) + '99999'#10'%%EOF'#10;
    RunCheck(Pdf, R);
    Check(R.Status[epl_Metadata] = eps_Incomplete, 'reconstructed: ' + MetadataStatusText(R));
    RunCheck(SimplePdf('/Names << /EmbeddedFiles << /Names [(zugferd-invoice.xml) 4 0 R] >> >>',
      '<< /F (zugferd-invoice.xml) /EF << /F 5 0 R >> >>', '', CheckXml), R);
    Check(R.Status[epl_Metadata] = eps_Incomplete, 'ZUGFeRD 2.0: ' + MetadataStatusText(R));
    CheckEquals(0, MetadataCount(R), 'ZUGFeRD 2.0 not checked');
    RunCheck(SimplePdf('', GoodSpec, GoodStream, CheckXml), R);
    Check(R.Status[epl_Metadata] = eps_NotRun, 'no invoice: ' + MetadataStatusText(R));
    RunCheck('no PDF', R);
    Check(R.Status[epl_Metadata] = eps_NotRun, 'not readable: ' + MetadataStatusText(R));
  finally
    Checker.Free;
    R.Free;
  end;
end;

{ The caller's way through the facade: a UBL invoice without BT-24 has no
  specification, so the syntax comes from Info.Syntax (LX-PDF-10). }
procedure TestCheckFactsFacade;
var
  R: TLandrixEInvoicePdfCheckResult;
  Checker: TLandrixEInvoicePdfChecker;
  Doc: TLandrixEInvoiceDocument;
  F: TLandrixEInvoicePdfInvoiceFacts;
begin
  R := TLandrixEInvoicePdfCheckResult.Create;
  Checker := TLandrixEInvoicePdfChecker.Create;
  try
    RunCheck(SimplePdf(TreeAndAF, GoodSpec, '/Type /EmbeddedFile /Subtype /text#2Fxml /Params << /ModDate (D:2026) >>',
      '<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"/>'), R);
    Check(R.Status[epl_Embedding] = eps_Passed, 'first pass: ' + StatusText(R));
    R.Invoice.Position := 0;
    Doc := TLandrixEInvoice.LoadFromStream(R.Invoice, [eio_NoPdf, eio_NoRuleCheck]);
    try
      Check(not Doc.Info.SpecFound and (Doc.Info.Syntax = esy_UBL), 'UBL without specification');
      F.Target := Doc.Info.Spec.Target;
      if not Doc.Info.SpecFound then
        F.Target.Syntax := Doc.Info.Syntax;
      F.SellerCountryCode := Doc.Invoice.AccountingSupplierParty.Address.CountryCode;
      F.BuyerCountryCode := Doc.Invoice.AccountingCustomerParty.Address.CountryCode;
    finally
      Doc.Free;
    end;
    CheckEquals(1, Checker.CheckInvoiceFacts(R, F), 'one error');
    CheckEquals(1, Findings(R, 'LX-PDF-10', 'UBL'), 'UBL found: ' + StatusText(R));
    Check(R.Status[epl_Embedding] = eps_Failed, 'failed');
  finally
    Checker.Free;
    R.Free;
  end;
end;

procedure TestCheckFile;
var
  R: TLandrixEInvoicePdfCheckResult;
  Checker: TLandrixEInvoicePdfChecker;
  S: TMemoryStream;
  Pdf: AnsiString;
begin
  R := TLandrixEInvoicePdfCheckResult.Create;
  Checker := TLandrixEInvoicePdfChecker.Create;
  try
    CheckEquals(1, Checker.CheckFile(RepositoryRoot + 'no-such-file.pdf', R), 'one error');
    Check(R.Status[epl_Embedding] = eps_Failed, 'failed');
    CheckEquals(1, Findings(R, 'LX-PDF-01', 'File not readable'), StatusText(R));
    CheckEquals(0, Checker.CheckStream(nil, nil), 'no result, nothing to do');
    S := TMemoryStream.Create;
    try
      Pdf := 'junk' + SimplePdf(TreeAndAF, GoodSpec, GoodStream, CheckXml);
      S.WriteBuffer(Pdf[1], Length(Pdf));
      S.Position := 4;
      CheckEquals(0, Checker.CheckStream(S, R), 'from the stream position: ' + StatusText(R));
      Check(R.Status[epl_Embedding] = eps_Passed, 'passed from the position');
    finally
      S.Free;
    end;
  finally
    Checker.Free;
    R.Free;
  end;
end;

{ The object layer has its own copy of the public limits. }
procedure TestLimits;
begin
  CheckEquals(LandrixEInvoicePdfMaxStreamSize, LandrixEInvoicePdfObjectMaxStreamSize, 'stream size');
  CheckEquals(LandrixEInvoicePdfMaxDepth, LandrixEInvoicePdfObjectMaxDepth, 'depth');
  CheckEquals(LandrixEInvoicePdfMaxFileSize, LandrixEInvoicePdfObjectMaxFileSize, 'file size');
end;

procedure Register;
begin
  RegisterTest('Pdf.Limits', TestLimits);
  RegisterTest('Pdf.Detection', TestDetection);
  RegisterTest('Pdf.Filters', TestFilters);
  RegisterTest('Pdf.DamagedStreams', TestDamagedStreams);
  RegisterTest('Pdf.Structure', TestStructure);
  RegisterTest('Pdf.IncrementalUpdate', TestIncrementalUpdate);
  RegisterTest('Pdf.HybridXref', TestHybridXref);
  RegisterTest('Pdf.Encryption', TestEncryption);
  RegisterTest('Pdf.Corpus', TestCorpus);
  RegisterTest('Pdf.Collector', TestCollector);
  RegisterTest('Pdf.CheckEmbedding', TestCheckEmbedding);
  RegisterTest('Pdf.CheckFile', TestCheckFile);
  RegisterTest('Pdf.CheckFacts', TestCheckFacts);
  RegisterTest('Pdf.CheckFactsFacade', TestCheckFactsFacade);
  RegisterTest('Pdf.CheckMetadata', TestCheckMetadata);
end;

end.
