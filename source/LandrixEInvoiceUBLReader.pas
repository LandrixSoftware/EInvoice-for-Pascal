            AObject.ReferenceDate := ReadLeaf('date');
          end;
        end
        else if IsElement(NS_CBC, 'ReferenceTime') then
        begin
          if Seen[2] then
            SkipDuplicate
          else
          begin
            Seen[2] := True;
            CheckNoAttributes(False);
            AObject.ReferenceTime := ReadLeaf('time');
          end;
        end
        else if IsElement(NS_CBC, 'Description') then
        begin
          CheckNoAttributes(False);
          AObject.Description.Add(ReadLeaf('string'));
        end
        else if IsElement(NS_CBC, 'StatusReasonCode') then
        begin
          if Seen[4] then
            SkipDuplicate
          else
          begin
            Seen[4] := True;
            ReadCode(AObject.StatusReasonCode);
          end;
        end
        else if IsElement(NS_CBC, 'StatusReason') then
        begin
          CheckNoAttributes(False);
          AObject.StatusReason.Add(ReadLeaf('string'));
        end
        else if IsElement(NS_CBC, 'SequenceID') then
        begin
          if Seen[6] then
            SkipDuplicate
          else
          begin
            Seen[6] := True;
            ReadID(AObject.SequenceID);
          end;
        end
        else if IsElement(NS_CBC, 'Text') then
        begin
          CheckNoAttributes(False);
          AObject.Text.Add(ReadLeaf('string'));
        end
        else if IsElement(NS_CBC, 'IndicationIndicator') then
        begin
          if Seen[8] then
            SkipDuplicate
          else
          begin
            Seen[8] := True;
            CheckNoAttributes(False);
            AObject.IndicationIndicator := ReadLeaf('boolean');
          end;
        end
        else if IsElement(NS_CBC, 'Percent') then
        begin
          if Seen[9] then
            SkipDuplicate
          else
          begin
            Seen[9] := True;
            CheckNoAttributes(False);
            AObject.Percent := ReadLeaf('decimal');
          end;
        end
        else if IsElement(NS_CBC, 'ReliabilityPercent') then
        begin
          if Seen[10] then
            SkipDuplicate
          else
          begin
            Seen[10] := True;
            CheckNoAttributes(False);
            AObject.ReliabilityPercent := ReadLeaf('decimal');
          end;
        end
        else if IsElement(NS_CAC, 'Condition') then
        begin
          ReadCondition(AObject.Condition.Add, False);
        end
        else
          SkipUnknown;
      xttText, xttCData:
        if not FReader.IsWhitespace then
          Report(edk_UnexpectedText, 'unexpected text ignored');
    else
      ; { comments and processing instructions are skipped }
    end;
end;

