procedure LandrixEInvoiceWriteUBLInvoice(AInvoice: TLandrixUBLInvoice; AWriter: TLandrixXmlWriter;
  ADiagnostics: TLandrixEInvoiceDiagnostics);
var
  Own: TLandrixEInvoiceDiagnostics;
  W: TUBLWriter;
begin
  Own := nil;
  W := nil;
  try
    if ADiagnostics = nil then
    begin
      Own := TLandrixEInvoiceDiagnostics.Create;
      ADiagnostics := Own;
    end;
    W := TUBLWriter.Create(AWriter, ADiagnostics);
    AWriter.StartElementNs(LandrixUBLNamespaceINV, '', 'Invoice');
    AWriter.DeclareNamespace('cac', LandrixUBLNamespaceCAC);
    AWriter.DeclareNamespace('cbc', LandrixUBLNamespaceCBC);
    W.WriteInvoice(AInvoice, '/Invoice');
    AWriter.EndElement;
  finally
    W.Free;
    Own.Free;
  end;
end;

