  end;
  if not AObject.OrderReference.IsEmpty then
  begin
    FWriter.StartElement('cac:OrderReference');
    WriteOrderReference(AObject.OrderReference, APath + '/cac:OrderReference');
    FWriter.EndElement;
  end;
  for I := 0 to AObject.BillingReference.Count - 1 do
  begin
    FWriter.StartElement('cac:BillingReference');
    WriteBillingReference(AObject.BillingReference[I], APath + '/cac:BillingReference');
    FWriter.EndElement;
  end;
  for I := 0 to AObject.DespatchDocumentReference.Count - 1 do
  begin
    FWriter.StartElement('cac:DespatchDocumentReference');
    WriteDocumentReference(AObject.DespatchDocumentReference[I], APath + '/cac:DespatchDocumentReference');
